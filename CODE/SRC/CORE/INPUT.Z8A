;                                       ****************************************
;                                       * INPUT                                *
;                                       ****************************************
;
; KEYBOARD INPUT AND MAIN DISPATCH LOOP.
; CHECKS MATRIX ACCENT COMBOS (GRAPH + VOWELS) AND HARDWARE DEAD KEY.
; USES BIOS CHSNS / CHGET FOR NON-BLOCKING CONSOLE INPUT.
; CURSOR BLINKING TIMED VIA SYSTEM JIFFY (#FC9E).


; --- MAINLOOP                  ----------------------------------------


; - MAINLOOP ---------------------------
; - MAIN EDITOR EVENT LOOP
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

MAINLOOP        ; CHECK CLOCK / COLON UPDATE
                CALL    CHKCLK

                ; SUPPRESS BIOS KANA LOCK AND KANA LED
                LD      A, (KANAST)
                OR      A
                CALL    NZ, KANARST
                LD      A, (KANAMOD)
                RRA
                CALL    C, KANARST

                ; CHECK MATRIX ACCENTS (GRAPH COMBOS & HARDWARE DEAD KEY)
                CALL    CHKACNT
                JR      C, .GOTACNT

                ; POLL KEYBOARD VIA BIOS CHSNS (#009C)
                LD      IX, CHSNS
                CALL    BIOSCALL
                JR      NZ, .KEYHIT

                ; NO KEY: UPDATE CURSOR BLINK USING JIFFY
                LD      A, (JIFFY)
                LD      HL, BLNKCNT
                SUB     (HL)
                CP      BLNKTCK         ; 0.3 S AT 50 HZ, 0.25 S AT 60 HZ
                JR      C, MAINLOOP

                ; TOGGLE CURSOR BLINK PHASE
                LD      A, (JIFFY)
                LD      (BLNKCNT), A
                CALL    DRWCUR          ; TOGGLES XOR OVERLAY
                LD      A, (BLNKPH)
                XOR     1
                LD      (BLNKPH), A
                JR      MAINLOOP

.GOTACNT        ; ACCENT KEY HIT DIRECTLY FROM MATRIX: ERASE CURSOR IF VISIBLE
                PUSH    AF
                LD      A, (BLNKPH)
                AND     A
                JR      Z, .ACNOERA
                CALL    DRWCUR
                XOR     A
                LD      (BLNKPH), A
.ACNOERA        POP     AF
                CALL    DISPKEY
                JR      .DRAWCUR

.KEYHIT         ; IF CURSOR IS VISIBLE, ERASE BEFORE EDITING/MOVING
                LD      A, (BLNKPH)
                AND     A
                JR      Z, .NOERASE
                CALL    DRWCUR
                XOR     A
                LD      (BLNKPH), A
.NOERASE        ; READ KEY FROM KEYBOARD BUFFER VIA BIOS CHGET (#009F)
                LD      IX, CHGET
                CALL    BIOSCALL

                ; #01 IS BOTH CTRL+A AND THE HEADER OF THE MSX 2-BYTE
                ; GRAPHIC SEQUENCE (#01 FOLLOWED BY CODE). ONLY THE PPI
                ; TELLS THEM APART: CTRL HELD MEANS CTRL+A, ELSE DROP.
                CP      #01
                JR      NZ, .DISPCH
                CALL    READMOD         ; A = MODIFIER BITS
                AND     MODCTRL
                JR      Z, .DRPGRPH     ; NO CTRL: GRAPHIC HEADER
                LD      A, #01          ; CTRL HELD: DISPATCH AS CTRL+A

.DISPCH         ; CLEAR ANY PENDING LOAD ERROR / STATUS MSG ON USER KEYPRESS
                PUSH    AF
                XOR     A
                LD      (LOADERR), A
                LD      (STATMSG), A
                POP     AF

                ; DISPATCH KEYPRESS THROUGH ACTIVE KEYMAP AND ACTION CATALOG
                CALL    DISPKEY

.DRAWCUR        ; STATUS BAR FOLLOWS THE KEY (LN / COL / FLAGS), THEN THE CURSOR
                CALL    ADJLCOL
                JR      NC, .NOSCRL
                LD      A, (SELACT)     ; A SELECTION COMES BACK IN THE SAME
                LD      (SELREDR), A    ; PASS, NOT LAID OVER THE PLAIN PAGE
                CALL    REDRAW
                XOR     A
                LD      (SELREDR), A
                LD      A, (SELACT)
                OR      A
                CALL    NZ, SELPOST
.NOSCRL         CALL    DRWSTAT
                CALL    DRWCUR
                CALL    CHKCLK          ; UPDATE CLOCK EVEN WHILE MOVING/TYPING
                LD      A, 1
                LD      (BLNKPH), A
                LD      A, (JIFFY)
                LD      (BLNKCNT), A
                JP      MAINLOOP

.DRPGRPH        ; READ AND DISCARD TRAILING GRAPHIC CODE BYTE
                LD      IX, CHSNS
                CALL    BIOSCALL
                JR      Z, .DRAWCUR
                LD      IX, CHGET
                CALL    BIOSCALL
                JR      .DRAWCUR


; --- KEYRUN                    ----------------------------------------


; - KEYRUN -----------------------------
; - SWALLOW REPEATS OF ONE KEY WAITING IN THE BIOS KEYBOARD BUFFER
; - A HELD CURSOR KEY QUEUES FASTER THAN A SCROLL CAN BE PAINTED, SO THE
; - CURSOR KEPT MOVING AFTER THE KEY WAS RELEASED. THE CALLER TAKES THE
; - QUEUED COPIES HERE AND MOVES ONCE BY THE WHOLE COUNT. ONLY AN IDENTICAL
; - CODE IS TAKEN, AND ONLY WHILE THE MODIFIER ROW STILL READS AS IT DID WHEN
; - THE FIRST ONE WAS DISPATCHED (MODKEYS): A KEY TYPED AFTER RELEASING
; - SHIFT OR GRAPH IS LEFT FOR ITS OWN DISPATCH.
; - IN:  C = KEY CODE, B = MAXIMUM TO TAKE
; - OUT: A = NUMBER TAKEN (0..B)
; - CLOBBERS: AF, BC, DE, HL, IX
; -

KEYRUN          LD      D, 0            ; TAKEN SO FAR
.NEXT           LD      A, D
                CP      B
                JR      Z, .DONE

                ; MODIFIERS STILL AS DISPATCHED?
                LD      A, 6
                CALL    READROW
                CPL
                AND     %00000111
                LD      HL, MODKEYS
                CP      (HL)
                JR      NZ, .DONE

                ; A KEY WAITING, AND IS IT OURS?
                PUSH    BC
                PUSH    DE
                LD      IX, CHSNS
                CALL    BIOSCALL
                POP     DE
                POP     BC
                JR      Z, .DONE
                LD      HL, (GETPNT)
                LD      A, (HL)
                CP      C
                JR      NZ, .DONE
                PUSH    BC
                PUSH    DE
                LD      IX, CHGET       ; TAKE IT
                CALL    BIOSCALL
                POP     DE
                POP     BC
                INC     D
                JR      .NEXT

.DONE           LD      A, D
                RET


; --- CHKACNT                   ----------------------------------------


; - CHKACNT ----------------------------
; - CHECK KEYBOARD MATRIX FOR DEAD KEY AND GRAPH+ACCENT KEYS
; - BYPASSES REGIONAL BIOS GRAPH TABLES (JAPANESE BIOS DROPS A, O, U, N)
; - IN:  NONE
; - OUT: CARRY SET: A = ACCENTED CHAR CODE READY TO DISPATCH
; -      CARRY RESET: NO GRAPH ACCENT HIT
; - CLOBBERS: ALL
; -

CHKACNT         ; --- STEP 1: CHECK DEAD KEY (ROW 2 BIT 5) OR KANA (ROW 6 BIT 4) ---
                ; CHECK ROW 2, BIT 5 (EUROPEAN DEAD KEY)
                LD      A, 2
                CALL    READROW
                BIT     5, A
                JR      Z, .ISDEAD      ; 0 = PRESSED (ACTIVE LOW)

                ; CHECK ROW 6, BIT 4 (JAPANESE KANA / INTL CODE KEY)
                LD      A, 6
                CALL    READROW
                BIT     4, A
                JR      Z, .ISDEAD      ; 0 = PRESSED (ACTIVE LOW)

                ; NEITHER KEY PRESSED: EDGE DETECTOR RELEASE
                LD      A, (LASTDED)
                OR      A
                JR      Z, .CHKGRP      ; ALREADY RELEASED
                XOR     A
                LD      (LASTDED), A    ; CLEAR DEAD KEY HELD FLAG
                CALL    KANARST         ; TURN OFF KANA LED ON RELEASE
                JR      .CHKGRP

.ISDEAD         ; DEAD KEY OR KANA PRESSED: CHECK EDGE DETECTION
                LD      A, (LASTDED)
                OR      A
                JR      NZ, .CHKGRP     ; ALREADY HELD, SKIP TO GRAPH CHECK

                LD      A, 1
                LD      (LASTDED), A    ; MARK DEAD KEY HELD

                ; CHECK SHIFT (ROW 6, BIT 0)
                LD      A, 6
                CALL    READROW
                BIT     0, A            ; 0 = SHIFT PRESSED
                JR      Z, .DEDSHF
                LD      A, DEDACUT      ; 1 = ACUTE ACCENT
                JR      .DEDSET
.DEDSHF         LD      A, DEDDIAR      ; 2 = DIAERESIS
.DEDSET         LD      (DEADST), A
                CALL    KANARST         ; TURN OFF KANA LED & RESET KANAST

                ; PURGE BIOS KEYBOARD BUFFER
                LD      IX, KILBUF
                CALL    BIOSCALL
                JR      .CHKGRP

.CHKGRP         ; --- STEP 2: CHECK GRAPH KEY (ROW 6, BIT 2) ---
                LD      A, 6
                CALL    READROW
                BIT     2, A            ; 0 = GRAPH PRESSED
                JR      Z, .GRPDWN

                ; GRAPH NOT PRESSED: CLEAR LAST PRESSED GRAPH KEY
                LD      A, (LASTGRP)
                OR      A
                JR      Z, .NOGPCLR
                XOR     A
                LD      (LASTGRP), A
                LD      IX, KILBUF
                CALL    BIOSCALL
.NOGPCLR        OR      A               ; RESET CARRY
                RET

.GRPDWN         ; --- STEP 3: SCAN ACCENT KEYS ---
                ; ROW 2: BIT 6 = 'A', BIT 4 = '?'
                LD      A, 2
                CALL    READROW
                BIT     6, A
                LD      C, #61          ; 'a'
                JR      Z, .GRPFND
                BIT     4, A
                LD      C, #3F          ; '?'
                JR      Z, .GRPFND

                ; ROW 3: BIT 2 = 'E', BIT 6 = 'I'
                LD      A, 3
                CALL    READROW
                BIT     2, A
                LD      C, #65          ; 'e'
                JR      Z, .GRPFND
                BIT     6, A
                LD      C, #69          ; 'i'
                JR      Z, .GRPFND

                ; ROW 4: BIT 4 = 'O', BIT 3 = 'N'
                LD      A, 4
                CALL    READROW
                BIT     4, A
                LD      C, #6F          ; 'o'
                JR      Z, .GRPFND
                BIT     3, A
                LD      C, #6E          ; 'n'
                JR      Z, .GRPFND

                ; ROW 5: BIT 2 = 'U', BIT 4 = 'W'
                LD      A, 5
                CALL    READROW
                BIT     2, A
                LD      C, #75          ; 'u'
                JR      Z, .GRPFND
                BIT     4, A
                LD      C, #77          ; 'w'
                JR      Z, .GRPFND

                ; ROW 0: BIT 1 = '1'
                XOR     A
                CALL    READROW
                BIT     1, A
                LD      C, #31          ; '1'
                JR      Z, .GRPFND

                ; NO ACCENT KEY PRESSED WITH GRAPH
                LD      A, (LASTGRP)
                OR      A
                JR      Z, .NOACCLR
                XOR     A
                LD      (LASTGRP), A
                LD      IX, KILBUF
                CALL    BIOSCALL
.NOACCLR        OR      A               ; RESET CARRY
                RET

.GRPFND         ; ACCENT KEY FOUND IN C!
                ; CHECK DEBOUNCING / REPEAT
                LD      A, (LASTGRP)
                CP      C
                JR      NZ, .GRPINIT    ; NEW KEY PRESSED

                ; SAME KEY HELD: CHECK EXPIRY OF (GRPTIM)
                LD      A, (JIFFY)
                LD      HL, GRPTIM
                SUB     (HL)            ; A = JIFFY - GRPTIM
                AND     #80             ; TEST SIGN (BIT 7)
                JR      NZ, .GRPBUSY    ; STILL WAITING: RETURN NC

                ; TIMER EXPIRED: SCHEDULE NEXT REPEAT (~70 MS)
                LD      A, (JIFFY)
                ADD     A, 4
                LD      (GRPTIM), A
                JR      .GRPTRN

.GRPINIT        LD      A, C
                LD      (LASTGRP), A
                LD      A, (JIFFY)
                ADD     A, 25           ; INITIAL DELAY (~400 MS)
                LD      (GRPTIM), A
                JR      .GRPTRN

.GRPBUSY        LD      IX, KILBUF
                CALL    BIOSCALL        ; PURGE BIOS BUFFER WHILE KEY HELD
                OR      A               ; RESET CARRY: NO KEY
                RET

.GRPTRN         ; TRANSLATE C INTO ACCENTED CHARACTER
                ; CHECK SHIFT (ROW 6, BIT 0)
                PUSH    BC
                LD      A, 6
                CALL    READROW
                BIT     0, A            ; 0 = SHIFT PRESSED
                POP     BC
                JR      Z, .GRPSHFT

                ; UNSHIFTED TABLE
                LD      HL, .GRPTBL
                JR      .GRPLKUP

.GRPSHFT        ; SHIFTED TABLE
                LD      HL, .GRPSHTB

.GRPLKUP        LD      A, (HL)
                OR      A
                JR      Z, .GRPFAIL     ; NOT FOUND (SAFETY)
                CP      C
                JR      Z, .GRPOK
                INC     HL
                INC     HL
                JR      .GRPLKUP

.GRPOK          INC     HL
                LD      A, (HL)         ; A = ACCENTED CHAR CODE
                PUSH    AF
                LD      IX, KILBUF
                CALL    BIOSCALL        ; PURGE ANY JUNK FROM BIOS KEYBUF
                POP     AF
                SCF                     ; SET CARRY: CHARACTER READY IN A
                RET

.GRPFAIL        XOR     A               ; RESET CARRY
                RET

.GRPTBL         ; UNSHIFTED GRAPH ACCENTS: [KEY, CHAR]
                DEFB    #61, #A0, #65, #82, #69, #A1, #6F, #A2
                DEFB    #75, #A3, #6E, #A4, #77, #81, #31, #AD
                DEFB    #3F, #A8, #00

.GRPSHTB        ; SHIFTED GRAPH ACCENTS: [KEY, CHAR]
                DEFB    #61, #A0, #65, #90, #69, #A1, #6F, #A2
                DEFB    #75, #A3, #6E, #A5, #77, #9A, #31, #AD
                DEFB    #3F, #A8, #00


; --- KANARST                   ----------------------------------------


; - KANARST ----------------------------
; - RESET KANA STATUS AND TURN OFF KANA LED VIA PSG R#15
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

KANARST         PUSH    HL
                XOR     A
                LD      (KANAST), A     ; RESET KANAST TO 0 (ALPHANUMERIC)
                LD      HL, KANAMOD
                RES     0, (HL)         ; CLEAR SHIFT-KANA MODE BIT
                LD      A, #0F          ; PSG REGISTER 15
                OUT     (PSG_REG), A
                IN      A, (PSG_RD)
                OR      #80             ; BIT 7 = 1 -> KANA LED OFF
                OUT     (PSG_WRT), A
                POP     HL
                RET


; --- CURSHP                    ----------------------------------------


; - CURSHP -----------------------------
; - THE SHAPE DRWCUR MUST USE NOW. THE CURSOR IS AN XOR, SO IT HAS TO BE
; - ERASED WITH THE SHAPE IT WAS DRAWN WITH: WHEN IT GOES UP (BLNKPH = 0,
; - EVERY CALLER FLIPS BLNKPH AFTER DRWCUR) THE SHAPE IS DERIVED FROM THE
; - MODE AND LATCHED IN CURSHD; WHEN IT COMES DOWN THE LATCH IS RETURNED,
; - WHATEVER THE MODE HAS BECOME IN BETWEEN.
; - VI: NORMAL AND VISUAL BLOCK, INSERT BAR, REPLACE UNDERLINE.
; - OTHER PROFILES: INSERT UNDERLINE, OVERWRITE BLOCK.
; - IN:  NONE (USES BLNKPH, KMAPID, VIMODE, INSMODE)
; - OUT: A = CURBLK, CURBAR OR CURUND
; - CLOBBERS: F
; -

CURSHP          LD      A, (BLNKPH)
                OR      A
                LD      A, (CURSHD)
                RET     NZ              ; COMING DOWN: THE SHAPE IT WENT UP WITH
                LD      A, (KMAPID)
                CP      KMVI
                JR      NZ, .CUA
                LD      A, (VIMODE)
                OR      A               ; VIMNORM: BLOCK (A = CURBLK)
                JR      Z, .LATCH
                LD      A, (INSMODE)
                OR      A               ; OVR_MODE = 0: R, REPLACE
                LD      A, CURBAR
                JR      NZ, .LATCH
                LD      A, CURUND
                JR      .LATCH
.CUA            LD      A, (INSMODE)
                OR      A               ; OVR_MODE = 0: OVERWRITE, BLOCK
                JR      Z, .LATCH       ; A = 0 = CURBLK
                LD      A, CURUND
.LATCH          LD      (CURSHD), A
                RET


; --- TEXT FIELD                ----------------------------------------


; - FLDKEY -----------------------------
; - ONE KEY FOR THE TEXT FIELD OF A DIALOG (INPBUF / INPLEN, CARET AT
; - INPCAR, AT MOST EDWID CHARACTERS). LEFT / RIGHT MOVE THE CARET, HOME
; - AND SHIFT+HOME (CLS) TAKE IT TO EITHER END, BS DELETES BEFORE IT, DEL
; - UNDER IT, AND A CHARACTER OF THE CLASS IS INSERTED AT IT. A DIALOG
; - THAT USES LEFT / RIGHT FOR ITS FOCUS KEEPS THEM AND NEVER PASSES THEM.
; - IN:  A = KEY, E = CHARACTER CLASS (ED_DIGIT OR ED_FILE)
; - OUT: CY = 0: THE FIELD CHANGED, REPAINT IT.  CY = 1: NOTHING TO DO
; - CLOBBERS: ALL
; -

FLDKEY          LD      C, A
                LD      A, (INPLEN)
                LD      B, A            ; B = LENGTH
                LD      HL, INPCAR      ; A CARET PAST THE END WOULD MAKE THE
                CP      (HL)            ; LDIR / LDDR COUNTS BELOW ZERO, I.E.
                JR      NC, .CAROK      ; 64 KB: CLAMP IT TO THE LENGTH
                LD      (HL), A
.CAROK          LD      A, C
                CP      CLEFT
                JR      Z, .LEFT
                CP      CRIGHT
                JR      Z, .RIGHT
                CP      HOMEKEY
                JR      Z, .HOME
                CP      CLSKEY
                JR      Z, .END
                CP      BS
                JR      Z, .BS
                CP      DEL
                JR      Z, .DEL
                DEC     E               ; ED_FILE?
                JR      Z, .FILE
                CP      '0'
                RET     C
                CP      '9' + 1
                CCF
                RET     C
                JR      .INS
.FILE           CALL    FILECHR
                RET     C

                ; INSERT A AT THE CARET, IF THERE IS ROOM
.INS            LD      C, A            ; C = CHARACTER
                LD      A, (EDWID)
                LD      B, A
                LD      A, (INPLEN)
                CP      B
                SCF
                RET     Z               ; FULL: IGNORED, SILENTLY
                LD      E, A
                LD      D, 0            ; DE = LENGTH
                INC     A
                LD      (INPLEN), A
                LD      HL, INPBUF
                ADD     HL, DE          ; HL = THE NUL
                LD      A, (INPCAR)
                LD      B, A            ; B = CARET
                LD      A, E
                SUB     B
                INC     A               ; LENGTH - CARET + 1 >= 1
                PUSH    BC
                LD      C, A
                LD      B, 0
                LD      D, H
                LD      E, L
                INC     DE
                LDDR                    ; THE TAIL AND ITS NUL, ONE RIGHT
                INC     HL              ; HL = INPBUF + CARET
                POP     BC
                LD      (HL), C
                LD      A, B
                INC     A
                JR      .SETCAR

.LEFT           LD      A, (INPCAR)
                OR      A
                SCF
                RET     Z
                DEC     A
                JR      .SETCAR
.RIGHT          LD      A, (INPCAR)
                CP      B
                SCF
                RET     Z
                INC     A
                JR      .SETCAR
.HOME           XOR     A
                JR      .SETCAR
.END            LD      A, B
.SETCAR         LD      (INPCAR), A
                OR      A               ; CY = 0
                RET

.BS             LD      A, (INPCAR)
                OR      A
                SCF
                RET     Z
                DEC     A
                LD      (INPCAR), A
                JR      .DELAT
.DEL            LD      A, (INPCAR)
                CP      B
                SCF
                RET     Z               ; NOTHING UNDER THE CARET
.DELAT          LD      E, A
                LD      D, 0
                LD      HL, INPBUF
                ADD     HL, DE          ; HL = INPBUF + CARET
                LD      A, B
                SUB     E               ; LENGTH - CARET >= 1
                LD      C, A
                LD      B, 0
                LD      D, H
                LD      E, L
                INC     HL
                LDIR                    ; THE TAIL AND ITS NUL, ONE LEFT
                LD      HL, INPLEN
                DEC     (HL)
                OR      A               ; CY = 0
                RET


; - FILECHR ----------------------------
; - CHARACTER CLASS ED_FILE: WHAT MAY BE TYPED INTO A FILE NAME FIELD --
; - THE CHARACTERS OF A DOS 8.3 NAME, THE PATH SEPARATORS AND THE
; - WILDCARDS. LETTERS KEEP THE CASE THEY WERE TYPED IN: DOS FOLDS THE
; - NAME ITSELF, AND THE FIELD SHOWS NAMES AS THEY CAME.
; - IN:  A = CHARACTER
; - OUT: CY = 0: ACCEPTED, A UNCHANGED.  CY = 1: REFUSED
; - CLOBBERS: F, B, HL
; -

FILECHR         PUSH    AF
                CALL    SRCHUPC
                CP      'A'
                JR      C, .NOLET
                CP      'Z' + 1
                JR      C, .YES         ; A LETTER
.NOLET          CP      '0'
                JR      C, .SYM
                CP      '9' + 1
                JR      C, .YES         ; A DIGIT
.SYM            LD      HL, .OK
                LD      B, .OKEND - .OK
.SLP            CP      (HL)
                JR      Z, .YES
                INC     HL
                DJNZ    .SLP
                POP     AF
                SCF
                RET
.YES            POP     AF
                OR      A               ; CY = 0
                RET

.OK             DEFM    "$&#@!%'()-_{}~^`", #5C, ":.*?"
.OKEND
