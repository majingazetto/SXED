;                                       ****************************************
;                                       * RENDERER (SCREEN 2 / TMS9918)        *
;                                       ****************************************
;
; 64 COLS X 24 ROWS (32 CELLS X 24 ROWS OF 8X8 PATTERNS). A TEXT ROW IS A
; GUTTER CELL (TXCELL0) AND 61 TEXT COLUMNS IN THE 31 CELLS AFTER IT, THE
; RIGHT HALF OF THE LAST ONE A BLANK MARGIN.
; EACH CELL HOLDS TWO 4X8 GLYPHS FROM FONT4H, THE RIGHT ONE ROTATED INTO THE
; LOW NIBBLE (CELLPAT). COLORS COME FROM THE TMS9918 COLOR TABLE (8 BYTES PER CELL, ONE PER
; SCANLINE), BUT THE SHADOW KEEPS ONE BYTE PER CELL IN COLMAP AND COLDUMP
; EXPANDS IT X8 ON THE WAY OUT -- ALL EIGHT SCANLINES OF A CELL ALWAYS CARRY
; THE SAME COLOR. STYLES (BOLD, ITALIC, CODE) ARE DISPLAYED USING DISTINCT
; TMS9918 16-COLOR PALETTE ENTRIES (COLBOLD, COLITAL, COLUNDR).


; --- REDRAW                    ----------------------------------------


; - REDRAW -----------------------------
; - REDRAW ALL TEXT ROWS (TXRFIRST TO TXRLAST)
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

REDRAW          CALL    ADJLCOL
                XOR     A
                LD      (SELDRAWN), A
                CALL    REDRSB          ; SELREDR: NORMALISE THE SELECTION
                LD      B, TXRFIRST
.RDLP           PUSH    BC
                CALL    RENDEROW
                POP     BC
                CALL    REDRSEL         ; SELREDR: XOR THIS ROW'S EXTENT
                INC     B
                LD      A, B
                CP      TXRLAST + 1
                JR      NZ, .RDLP
                JP      REDRSE          ; SELREDR: RECORD WHAT WAS PAINTED




; --- RENDEROW                  ----------------------------------------


; - RENDEROW ---------------------------
; - RENDER A SINGLE SCREEN ROW (1..22) TO VRAM
; - IN:  B = SCREEN ROW (1..22)
; - OUT: NONE. WORKBUF HOLDS THE LINE RECORD.
; - CLOBBERS: AF, DE, HL, IX, IY (BC PRESERVED)
; -

RENDEROW        PUSH    BC              ; SAVE B = SCREEN ROW (1..22)
                XOR     A
                LD      (PREVROW), A

                ; CALCULATE DOC LINE = TOPLINE + B - TXRFIRST
                LD      HL, (TOPLINE)
                LD      A, B
                SUB     TXRFIRST
                LD      E, A
                LD      D, 0
                ADD     HL, DE
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .VALID

                ; BEYOND EOF: CLEAR ROW
                CALL    CLRROW
                POP     BC
                RET

.VALID          CALL    LINEREAD
                CALL    SCANMKUP

                ; RESTORE B = SCREEN ROW. LINEREAD ENDS IN AN LDIR AND
                ; SCANMKUP CLOBBERS BC, SO COMROW WOULD OTHERWISE COMPOSE
                ; EVERY ROW ON TOP OF ROW 0.
                POP     BC
                PUSH    BC

                ; COMPOSE ROW B INTO SHADOW BUFFERS
                CALL    VIDBANK
                XOR     A
                LD      (COLDIRT), A
                CALL    COMROW

                ; A SCROLL COMPOSES ITS NEW ROWS FIRST AND PUSHES THE BAND ONCE
                LD      A, (RNDNODMP)
                OR      A
                JR      NZ, .NODUMP

                ; RESTORE B = SCREEN ROW FOR VRAM DUMP
                POP     BC
                PUSH    BC

                ; DUMP 256 PATTERN BYTES TO VRAM PG TABLE (PGBASE + B * 256)
                LD      A, B
                LD      D, A
                LD      E, 0            ; DE = B * 256
                LD      HL, PATSHAD
                ADD     HL, DE          ; HL = SRC: PATSHAD + B * 256
                EX      DE, HL          ; DE = SRC, HL = B * 256
                LD      BC, PGBASE
                ADD     HL, BC          ; HL = VRAM DEST
                EX      DE, HL          ; HL = SRC, DE = VRAM DEST
                LD      BC, ROWLEN
                CALL    VDPDUMP

                ; DUMP THE ROW COLORS (COLMAP -> COLEXP -> CTBASE) -- ONLY IF
                ; COMROW CHANGED ONE. COLMAP ALWAYS MIRRORS THE VRAM COLOUR
                ; TABLE (EVERY WRITER DUMPS WHAT IT WRITES), SO A ROW WHOSE
                ; COLOURS CAME OUT THE SAME NEEDS NO COLDUMP (~4 MS).
                POP     BC
                PUSH    BC
                LD      A, (COLDIRT)
                OR      A
                CALL    NZ, COLDUMP

.NODUMP         CALL    TXTBANK
                POP     BC
                RET




; --- CLRROW                    ----------------------------------------


; - CLRROW -----------------------------
; - CLEARS ROW B IN SHADOWS AND VRAM (BLANK CELLS, DEFAULT COLOR)
; - IN:  B = SCREEN ROW (1..22)
; - OUT: NONE
; - CLOBBERS: AF, DE, HL
; -

CLRROW          PUSH    BC
                CALL    VIDBANK

                ; 1. CLEAR PATTERN SHADOW (256 BYTES OF 0)
                LD      A, B
                LD      D, A
                LD      E, 0            ; DE = B * 256
                LD      HL, PATSHAD
                ADD     HL, DE          ; HL = PATSHAD + B * 256
                LD      B, 0
                XOR     A
.CLP            LD      (HL), A
                INC     HL
                DJNZ    .CLP

                ; 2. FILL THE COLOR MAP ROW (32 BYTES OF VCOLTXT)
                POP     BC
                PUSH    BC
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = B * CELLROW
                LD      DE, COLMAP
                ADD     HL, DE          ; HL = COLMAP + B * 32
                LD      B, CELLROW
                LD      A, (VCOLTXT)
.COLP           LD      (HL), A
                INC     HL
                DJNZ    .COLP

                LD      A, (RNDNODMP)   ; COMPOSE ONLY: THE SCROLL PUSHES IT
                OR      A
                JR      NZ, .CLDONE

                ; 3. DUMP PATTERN SHADOW TO VRAM (PGBASE + B * 256)
                POP     BC
                PUSH    BC
                LD      A, B
                LD      D, A
                LD      E, 0            ; DE = B * 256
                LD      HL, PATSHAD
                ADD     HL, DE          ; HL = SRC: PATSHAD + B * 256
                EX      DE, HL          ; DE = SRC, HL = B * 256
                LD      BC, PGBASE
                ADD     HL, BC          ; HL = VRAM DEST
                EX      DE, HL          ; HL = SRC, DE = VRAM DEST
                LD      BC, ROWLEN
                CALL    VDPDUMP

                ; 4. DUMP THE ROW COLORS (COLMAP -> COLEXP -> CTBASE)
                POP     BC
                PUSH    BC
                CALL    COLDUMP

.CLDONE         CALL    TXTBANK
                POP     BC
                RET




; --- COMROW                    ----------------------------------------


; - COMROW -----------------------------
; - COMPOSES ONE ROW (GUTTER + 31 CELLS / 61 COLS + MARGIN) INTO PATSHAD
; - AND COLMAP
; - IN:  B = SCREEN ROW (0..23), WORKBUF HOLDS LINE RECORD
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL, IX, IY
; - NOTE: CALLER MUST HAVE VIDSEG BANKED AT PAGE 2
; -

COMROW          LD      A, B
                LD      D, A
                LD      E, 0
                LD      HL, PATSHAD
                ADD     HL, DE
                PUSH    HL
                POP     IX              ; IX = PATSHAD + ROW * 256

                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = ROW * CELLROW
                LD      DE, COLMAP
                ADD     HL, DE
                PUSH    HL
                POP     IY              ; IY = COLMAP + ROW * 32

                ; THE GUTTER: BLANK, IN THE DOCUMENT'S COLOR
                LD      B, TXCELL0
.GUTLP          PUSH    BC
                LD      A, ' '
                LD      C, A
                LD      DE, 0
                CALL    COMCELL
                POP     BC
                DJNZ    .GUTLP

                LD      B, 0            ; B = TEXT CELL INDEX (0..30)

.CELLP          ; GET LEFT CHARACTER AND ATTRIBUTE (COL = LEFTCOL + 2*B)
                LD      A, B
                ADD     A, A            ; A = 2*B
                LD      HL, LEFTCOL
                ADD     A, (HL)         ; A = LEFTCOL + 2*B
                LD      E, A
                LD      A, (WORKBUF)    ; LINE LENGTH
                CP      E
                JR      Z, .TAIL        ; PAST THE END: THE REST IS BLANK
                JR      C, .TAIL
                ; WITHIN LINE LENGTH
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      A, (HL)         ; A = LEFT CHAR
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                LD      D, (HL)         ; D = LEFT ATTR

.RGET           ; PUSH LEFT (A, D)
                PUSH    AF
                PUSH    DE

                ; GET RIGHT CHARACTER AND ATTRIBUTE (COL = LEFTCOL + 2*B + 1).
                ; THE LAST CELL'S RIGHT HALF IS THE MARGIN: BLANK BY POSITION,
                ; SINCE A LINE LONGER THAN THE VIEWPORT HAS A CHARACTER THERE
                LD      A, B
                CP      TXCELLS - 1
                JR      Z, .RBLNK
                ADD     A, A
                INC     A               ; A = 2*B + 1
                LD      HL, LEFTCOL
                ADD     A, (HL)         ; A = LEFTCOL + 2*B + 1
                LD      E, A
                LD      A, (WORKBUF)
                CP      E
                JR      Z, .RBLNK
                JR      C, .RBLNK
                LD      D, 0
                LD      HL, WORKBUF + 1
                ADD     HL, DE
                LD      C, (HL)         ; C = RIGHT CHAR
                LD      HL, WORKBUF + 1 + WORKATTR
                ADD     HL, DE
                LD      E, (HL)         ; E = RIGHT ATTR
                JR      .COMCL

.RBLNK          LD      C, ' '
                LD      E, 0

.COMCL          POP     HL              ; H = LEFT ATTR (IN D ORIGINALLY)
                LD      D, H
                POP     AF              ; A = LEFT CHAR
                PUSH    BC              ; SAVE B (CELL COUNTER)
                CALL    COMCELL
                POP     BC
                INC     B
                LD      A, B
                CP      TXCELLS
                JR      NZ, .CELLP
                RET

.TAIL           ; CELLS B..30 ARE ALL PAST THE END OF THE LINE: BLANK PATTERNS
                ; AND THE TEXT COLOUR, WITHOUT COMPOSING A PAIR OF SPACES PER
                ; CELL (~1,300 T EACH, MOST OF A REDRAW ON SHORT LINES).
                LD      A, TXCELLS
                SUB     B
                LD      B, A            ; B = CELLS LEFT (1..31)
                PUSH    IX
                POP     HL
                LD      C, A
                XOR     A
.TPAT           LD      (HL), A         ; 8 BLANK SCANLINES PER CELL
                INC     HL
                LD      (HL), A
                INC     HL
                LD      (HL), A
                INC     HL
                LD      (HL), A
                INC     HL
                LD      (HL), A
                INC     HL
                LD      (HL), A
                INC     HL
                LD      (HL), A
                INC     HL
                LD      (HL), A
                INC     HL
                DEC     C
                JR      NZ, .TPAT
                LD      A, (VCOLTXT)
.TCOL           CP      (IY+0)
                JR      Z, .TSAME
                LD      (IY+0), A
                LD      HL, COLDIRT
                LD      (HL), H         ; NON-ZERO (H = HIGH(COLDIRT))
.TSAME          INC     IY
                DJNZ    .TCOL
                RET




; --- COMCELL                   ----------------------------------------


; - COMCELL ----------------------------
; - COMPOSES ONE CELL (8 PATTERN BYTES + 1 COLOR MAP BYTE)
; - IN:  A = LCHAR, D = LATTR, C = RCHAR, E = RATTR, IX = PATSHAD, IY = COLMAP
; - OUT: IX += 8, IY += 1
; - CLOBBERS: AF, BC, DE, HL, IX, IY
; -

COMCELL         PUSH    DE              ; SAVE ATTRIBUTES (D=LATTR, E=RATTR)

                CALL    CELLPAT         ; 1-3. THE TWO GLYPHS INTO PATSHAD

                ; 4. MAP ATTRIBUTES TO THEME COLOR
                POP     DE              ; RESTORE D=LATTR, E=RATTR
                LD      A, D
                OR      E               ; A = LATTR | RATTR
                LD      C, A            ; C = ATTRS
                LD      A, (VCOLTXT)    ; DEFAULT COLOR
                BIT     0, C            ; ATRBOLD ?
                JR      Z, .NOTBD
                LD      A, (VCOLBOLD)
                JR      .SETCOL
.NOTBD          BIT     1, C            ; ATRITAL ?
                JR      Z, .NOTIT
                LD      A, (VCOLITAL)
                JR      .SETCOL
.NOTIT          BIT     2, C            ; ATRUNDR ?
                JR      Z, .NOTUN
                LD      A, (VCOLUNDR)
                JR      .SETCOL

                ; ATRMARK IS TESTED LAST ON PURPOSE.  A CELL IS TWO
                ; CHARACTERS, SO A DELIMITER THAT STARTS ON AN ODD COLUMN
                ; SHARES ITS CELL WITH CONTENT: LOWEST PRIORITY MEANS THE
                ; CONTENT KEEPS ITS OWN ROLE AND THE DELIMITER GIVES WAY,
                ; RATHER THAN A BOLD LETTER BEING PAINTED AS A DELIMITER.
                ; ALIGNED -- THE COMMON CASE -- THE PAIR OWNS ITS CELL AND
                ; VCOLMARK SHOWS.
.NOTUN          BIT     4, C            ; ATRMARK ?
                JR      Z, .SETCOL
                LD      A, (VCOLMARK)

.SETCOL         ; 5. WRITE ONE COLOR BYTE TO COLMAP, NOTING A CHANGE
                CP      (IY+0)
                JR      Z, .SAME
                LD      (IY+0), A
                LD      HL, COLDIRT
                LD      (HL), H         ; NON-ZERO (H = HIGH(COLDIRT))
.SAME           INC     IY
                RET


; --- CELLPAT                   ----------------------------------------


; - CELLPAT ----------------------------
; - COMPOSE TWO 4X8 GLYPHS INTO ONE 8X8 CELL PATTERN
; - IN:  A = LEFT CHAR, C = RIGHT CHAR, IX = DESTINATION (8 BYTES)
; - OUT: IX += 8
; - CLOBBERS: AF, B, DE, HL
; -
; - THE FONT HOLDS EVERY GLYPH IN THE HIGH NIBBLE. THE RIGHT ONE IS
; - MOVED TO THE LOW NIBBLE HERE, FOUR RRCA PER SCANLINE, INSTEAD OF
; - KEEPING A NIBBLE-SWAPPED COPY OF THE FONT: THAT COPY (FONT4L) COST
; - 2 KB OF PAGE 1 TPA, WHICH S2ED DOES NOT HAVE.
; -

CELLPAT         CALL    GLYPH
                EX      DE, HL          ; DE = LEFT GLYPH
                LD      A, C
                CALL    GLYPH
                EX      DE, HL          ; HL = LEFT, DE = RIGHT GLYPH
                LD      B, 8
.LP             LD      A, (DE)
                RRCA
                RRCA
                RRCA
                RRCA                    ; RIGHT GLYPH TO THE LOW NIBBLE
                OR      (HL)
                LD      (IX+0), A
                INC     HL
                INC     DE
                INC     IX
                DJNZ    .LP
                RET


; - GLYPH ------------------------------
; - ADDRESS OF A CHARACTER'S 4X8 GLYPH
; - IN:  A = CHARACTER
; - OUT: HL = FONT4H + A * 8 (GLYPH IN THE HIGH NIBBLE OF 8 BYTES)
; - CLOBBERS: AF
; -

GLYPH           LD      L, A
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL
                LD      A, H
                ADD     A, HIGH(FONT4H)
                LD      H, A
                RET




; --- PATINV                    ----------------------------------------


; - PATINV -----------------------------
; - INVERT A COLUMN RANGE ON ONE SCREEN ROW AND PUSH IT TO VRAM
; - XORS THE FOUR PIXEL COLUMNS EACH TEXT COLUMN OWNS INSIDE ITS CELL, SO A
; - SPACE BECOMES A SOLID 4 PX BLOCK AND A GLYPH ITS NEGATIVE.
; - THIS IS WHAT THE CURSOR AND THE SELECTION USE INSTEAD OF SWAPPING THE
; - CELL'S COLOR NIBBLES. THE COLOR TABLE ADDRESSES 8X1 SLICES, SO A COLOR
; - SWAP CANNOT INVERT HALF A CELL: IT PAINTED TWO COLUMNS AT A TIME, AND
; - SELDIFF'S ONE-COLUMN DELTAS LANDED ON THE SAME CELL TWICE AND CANCELLED.
; - IN:  H = SCREEN ROW (0..23), C = FIRST COLUMN (0..63), B = COLUMN COUNT
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL, IX
; - NOTE: CALLER MUST HAVE VIDSEG BANKED AT PAGE 2
; -

PATINV          LD      A, B
                AND     A
                RET     Z               ; EMPTY RANGE

                ; FIRST CELL AND THE NUMBER OF CELLS THE RANGE TOUCHES
                LD      A, C
                SRL     A
                LD      E, A            ; E = FIRST CELL
                LD      A, C
                ADD     A, B
                DEC     A               ; A = LAST COLUMN
                SRL     A               ; A = LAST CELL
                SUB     E
                INC     A
                LD      D, A            ; D = CELL COUNT

                PUSH    DE              ; SAVE CELL COUNT AND FIRST CELL
                LD      A, H
                PUSH    AF              ; SAVE SCREEN ROW

                ; IX = PATSHAD + ROW * ROWLEN
                LD      D, H
                LD      E, 0
                LD      HL, PATSHAD
                ADD     HL, DE
                PUSH    HL
                POP     IX

.PXLP           ; E = MASK FOR THIS COLUMN'S HALF OF ITS CELL
                LD      A, C
                AND     1
                LD      E, #F0
                JR      Z, .PXHAVE
                LD      E, #0F

.PXHAVE         ; HL = IX + (COLUMN / 2) * 8
                LD      A, C
                SRL     A
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; A = CELL * 8 (<= 248, NO CARRY)
                PUSH    IX
                POP     HL
                PUSH    DE              ; KEEP THE MASK
                LD      D, 0
                LD      E, A
                ADD     HL, DE
                POP     DE              ; E = MASK AGAIN

                PUSH    BC
                LD      B, 8
.PXBYTE         LD      A, (HL)
                XOR     E
                LD      (HL), A
                INC     HL
                DJNZ    .PXBYTE
                POP     BC

                INC     C
                DJNZ    .PXLP

                ; DUMP THE CELLS THE RANGE TOUCHED
                POP     AF              ; A = SCREEN ROW
                POP     DE              ; D = CELL COUNT, E = FIRST CELL
                PUSH    DE

                LD      H, A
                LD      A, E
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; A = FIRST CELL * 8
                LD      L, A            ; HL = ROW * ROWLEN + FIRST CELL * 8
                PUSH    HL

                LD      DE, PATSHAD
                ADD     HL, DE          ; HL = SOURCE
                POP     DE              ; DE = OFFSET
                PUSH    HL
                LD      HL, PGBASE
                ADD     HL, DE
                EX      DE, HL          ; DE = VRAM DESTINATION
                POP     HL              ; HL = SOURCE

                POP     BC              ; B = CELL COUNT
                PUSH    HL
                LD      L, B
                LD      H, 0
                ADD     HL, HL
                ADD     HL, HL
                ADD     HL, HL          ; HL = BYTE COUNT
                LD      B, H
                LD      C, L
                POP     HL              ; HL = SOURCE
                JP      VDPDUMP




; --- CURINV                    ----------------------------------------


; - CURINV -----------------------------
; - INVERT THE CURSOR SHAPE OF ONE TEXT COLUMN AND PUSH ITS CELL TO VRAM.
; - PATINV'S ONE-COLUMN CASE, CUT DOWN: BLOCK IS THE COLUMN'S FOUR PIXELS
; - ON ALL EIGHT SCANLINES, BAR THE LAST PIXEL OF THE PREVIOUS COLUMN (THE
; - BOUNDARY, AS VIM DRAWS IT), UNDERLINE ITS FOUR PIXELS
; - ON THE BOTTOM CURUNDH SCANLINES. PATINV ITSELF STAYS THE SELECTION'S.
; - IN:  H = SCREEN ROW (0..23), C = COLUMN (0..63), A = SHAPE (CURSHP)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; - NOTE: CALLER MUST HAVE VIDSEG BANKED AT PAGE 2
; -

CURINV          LD      B, 8            ; B = SCANLINES
                LD      D, 0            ; D = FIRST SCANLINE
                LD      E, #FF          ; E = SHAPE MASK
                CP      CURBAR
                JR      NZ, .NOBAR
                LD      E, #11          ; RIGHT PIXEL OF EITHER HALF...
                DEC     C               ; ...OF THE PREVIOUS COLUMN
.NOBAR          CP      CURUND
                JR      NZ, .SHAPED
                LD      B, CURUNDH
                LD      D, 8 - CURUNDH
.SHAPED         LD      A, C
                AND     1
                LD      A, #F0          ; EVEN COLUMN: HIGH NIBBLE
                JR      Z, .HALF
                LD      A, #0F          ; ODD COLUMN: LOW NIBBLE
.HALF           AND     E
                LD      E, A            ; E = XOR MASK

                LD      A, C
                SRL     A
                ADD     A, A
                ADD     A, A
                ADD     A, A            ; A = CELL * 8 (<= 248)
                LD      L, A            ; HL = ROW * ROWLEN + CELL * 8
                PUSH    HL              ; OFFSET, FOR THE DUMP
                LD      A, D
                PUSH    DE
                LD      DE, PATSHAD
                ADD     HL, DE
                LD      E, A
                LD      D, 0
                ADD     HL, DE          ; HL = FIRST SCANLINE IN THE SHADOW
                POP     DE              ; E = XOR MASK
.XLP            LD      A, (HL)
                XOR     E
                LD      (HL), A
                INC     HL
                DJNZ    .XLP

                POP     DE              ; DE = OFFSET
                LD      HL, PATSHAD
                ADD     HL, DE
                PUSH    HL              ; SOURCE: THE WHOLE CELL
                LD      HL, PGBASE
                ADD     HL, DE
                EX      DE, HL          ; DE = VRAM DESTINATION
                POP     HL
                LD      BC, 8
                JP      VDPDUMP


; --- GRID SHIFT (FILE BROWSER)  ----------------------------------------


                ASSERT  (PATSHAD & #FF) == 0
                ASSERT  (COLMAP & #FF) == 0


; - SHADROW ----------------------------
; - COPY A SPAN OF CELLS OF ONE SCREEN ROW ONTO ANOTHER ROW IN THE RAM
; - SHADOWS: PATTERNS (8 BYTES A CELL) AND COLOURS (1 BYTE A CELL). THE
; - CALLER PUSHES THE ROWS TO VRAM.
; - IN:  H = SOURCE ROW, L = DESTINATION ROW, D = FIRST CELL, E = CELLS
; - OUT: NONE
; - CLOBBERS: AF
; - NOTE: VIDSEG BANKED AT PAGE 2
; -

SHADROW         PUSH    BC
                PUSH    DE
                PUSH    HL
                LD      A, D
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      C, A            ; C = FIRST CELL * 8
                LD      A, E
                ADD     A, A
                ADD     A, A
                ADD     A, A
                LD      B, A            ; B = SPAN IN PATTERN BYTES
                LD      A, L
                ADD     A, HIGH PATSHAD
                LD      D, A
                LD      E, C            ; DE = DESTINATION PATTERNS
                LD      A, H
                ADD     A, HIGH PATSHAD
                LD      H, A
                LD      L, C            ; HL = SOURCE PATTERNS
                LD      C, B
                LD      B, 0
                LDIR
                POP     HL
                POP     DE
                PUSH    DE
                PUSH    HL
                LD      A, H
                CALL    .CADR
                PUSH    BC              ; SOURCE COLOURS
                LD      A, L
                CALL    .CADR           ; BC = DESTINATION COLOURS
                LD      A, E            ; A = CELLS
                POP     HL
                LD      D, B
                LD      E, C
                LD      C, A
                LD      B, 0
                LDIR
                POP     HL
                POP     DE
                POP     BC
                RET

                ; .CADR: A = ROW, D = CELL -> BC = COLMAP + ROW * 32 + CELL
.CADR           LD      C, A
                LD      B, 0
                SLA     C
                RL      B
                SLA     C
                RL      B
                SLA     C
                RL      B
                SLA     C
                RL      B
                SLA     C
                RL      B               ; BC = ROW * 32
                LD      A, C
                ADD     A, D            ; CELL <= 31: NO CARRY OUT OF A ROW
                LD      C, A
                LD      A, B
                ADD     A, HIGH COLMAP
                LD      B, A
                RET


; - GRDSCRL ----------------------------
; - MOVE A BAND OF SCREEN ROWS ONE ROW UP OR DOWN IN THE SHADOWS
; - IN:  A = 0: UP, ROWS B+1..B+C ONTO B..B+C-1
; -      A = 1: DOWN, ROWS B..B+C-1 ONTO B+1..B+C
; -      B = TOP ROW OF THE BAND, C = ROWS THAT MOVE (>= 1),
; -      D = FIRST CELL, E = CELLS
; - OUT: NONE
; - CLOBBERS: AF, BC, HL
; -

GRDSCRL         OR      A
                JR      NZ, .DOWN
.UPLP           LD      L, B
                LD      H, B
                INC     H               ; SOURCE: THE ROW BELOW
                CALL    SHADROW
                INC     B
                DEC     C
                JR      NZ, .UPLP
                RET
.DOWN           LD      A, B
                ADD     A, C
                LD      B, A            ; FIRST DESTINATION: THE BOTTOM ROW
.DNLP           LD      L, B
                LD      H, B
                DEC     H               ; SOURCE: THE ROW ABOVE
                CALL    SHADROW
                DEC     B
                DEC     C
                JR      NZ, .DNLP
                RET


; - BRWGSH -----------------------------
; - THE S2ED FILE BROWSER'S GRID FOLLOWS A ONE-ROW SCROLL: ITS ROWS ARE
; - SHIFTED IN THE SHADOWS, SO ONLY THE ROW THAT CAME IN NEEDS PAINTING.
; - IN PAGE 1 BECAUSE S2ED'S FEATURE CONTAINER HAS NO ROOM FOR IT.
; - IN:  A = NEW BRWTOP - OLD BRWTOP
; - OUT: CY = 1: NOT ONE ROW, NOTHING MOVED (THE CALLER PAINTS ALL)
; -      CY = 0: A = POSITION OF THE FIRST SLOT OF THE NEW ROW
; - CLOBBERS: AF, BC, DE, HL
; -

BRWGSH          LD      BC, BRWRLST * 256 + BRWROWS - 1
                LD      DE, BRWGC0 * 256 + BRWCOLS * BRWSLOT / 2
                DEC     A
                JR      Z, .UP          ; ONE ROW DOWN THE LIST: ROWS GO UP
                INC     A
                INC     A
                SCF
                RET     NZ              ; NEITHER +1 NOR -1
                INC     A               ; A = 1: ROWS GO DOWN
                CALL    GRDSCRL
                LD      A, (BRWTOP)     ; THE NEW ROW IS THE TOP ONE
                JR      .POS
.UP             CALL    GRDSCRL         ; A = 0
                LD      A, (BRWTOP)
                ADD     A, BRWROWS - 1  ; THE NEW ROW IS THE BOTTOM ONE
.POS            ADD     A, A
                ADD     A, A            ; ROW * BRWCOLS
                OR      A               ; CY = 0
                RET


; - BRWIS2 -----------------------------
; - S2ED FILE BROWSER: PAINT ONLY THE PART OF THE INFORMATION LINE THAT
; - CHANGED (BRWIDIF), WIDENED TO WHOLE CELLS -- A CELL HOLDS TWO
; - CHARACTERS -- AND DUMP ITS ROW, OR NOTHING IF THE LINE IS THE SAME.
; - THE LINE STARTS AT CHARACTER COLUMN 4, CELL 2 (.INFOD).
; - IN:  BRWINF FORMATTED (BRWINFO)
; - OUT: NONE
; - CLOBBERS: ALL
; - NOTE: CALLED FROM THE BROWSER, VIDSEG (= FTRSEG) BANKED AT PAGE 2
; -

BRWIS2          CALL    BRWIDIF
                RET     Z               ; THE ROW ON SCREEN IS STILL RIGHT
                BIT     0, C
                JR      Z, .EVEN
                DEC     C               ; START ON A CELL
                INC     B
.EVEN           BIT     0, B
                JR      Z, .WHOLE
                INC     B               ; END ON A CELL (BICLEN IS EVEN)
.WHOLE          CALL    BRWISPN         ; HL = THE SPAN, IN BRWNAME
                PUSH    BC
                ; CLEAR ITS CELLS: WINPUTS MAY LEAVE A SPACE UNDRAWN
                LD      A, C
                ADD     A, 4            ; CHARACTER COLUMN OF THE SPAN
                ADD     A, A
                ADD     A, A            ; CELL * 8 = COLUMN * 4
                LD      L, A
                LD      H, HIGH PATSHAD + BRWINFR
                LD      A, B
                ADD     A, A
                ADD     A, A            ; CELLS * 8 = COLUMNS * 4
                LD      B, A
                XOR     A
.CLR            LD      (HL), A
                INC     HL
                DJNZ    .CLR
                POP     BC
                LD      A, C
                ADD     A, 4
                LD      C, A
                LD      B, BRWINFR
                LD      HL, BRWNAME
                LD      A, (VCOLWIN)
                CALL    WINPUTS
                LD      A, BRWINFR
                JP      WDUMPR


; --- RENDIFF                   ----------------------------------------


; - RENDIFF ----------------------------
; - REPAINT SCREEN ROW B AFTER AN EDIT
; - IN:  B = SCREEN ROW (1..22), WORKBUF HOLDS THE NEW RECORD
; - OUT: NONE
; - CLOBBERS: ALL
; -
; - ON S2ED THIS IS RENDEROW. THE ROW IS COMPOSED IN RAM AND PUSHED WHOLE,
; - SO THERE IS NO DIFFERENTIAL PAINT TO FEED: THE PREVBUF CACHE THE S6
; - TARGETS KEEP WAS FILLED HERE (A 512-BYTE LDIR PER KEYSTROKE) AND NEVER
; - READ. COLDIRT ALREADY SKIPS THE COLOUR DUMP OF AN UNCHANGED ROW.
; -

RENDIFF         EQU     RENDEROW
