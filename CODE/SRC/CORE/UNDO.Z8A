;                                       ****************************************
;                                       * UNDO / REDO SUBSYSTEM                *
;                                       ****************************************
;
; TRANSACTIONAL LINE-DELTA RING BUFFER IN TPA RAM (PAGE 1):
;   LOCATED DYNAMICALLY AT UNDOBAS (= ENDVARS) UP TO UNDOBAS + UNDOSIZ (4 KB).
;   ASSERT GUARDS GUARANTEE IT NEVER OVERLAPS PAGE 2 (TXPAGE = #8000).
;   EACH RECORD IS A 10-BYTE TRANSACTION HEADER AND THE LINE IMAGE IT NEEDS:
;   NONE FOR A SPLIT OR A JOIN (REBUILT FROM THE LINES), TEXTCOLS CHARACTERS
;   FOR A LINE THAT FITS THEM, MAXCOLS (UNDOF_BIG) FOR A LONGER ONE.
;   SYMMETRIC SWAPPING OF PAYLOAD ENABLES BIDIRECTIONAL UNDO AND REDO WITHOUT
;   ANY SECONDARY ALLOCATIONS.
;


; --- UNDOINIT                  ----------------------------------------


; - UNDOINIT ---------------------------
; - INITIALIZE UNDO RING BUFFER POINTERS. THE HISTORY IS GONE, AND WITH
; - IT ANY WAY BACK TO THE STATE ON DISK: SAVEPTR BECOMES UNREACHABLE.
; - A CALLER THAT HAS JUST MADE THE DOCUMENT CLEAN FOLLOWS WITH UNDOSAV.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

UNDOINIT        LD      HL, SAVENIL
                LD      (SAVEPTR), HL
                XOR     A
                LD      (UNDOPTR), A
                LD      (UNDOPTR + 1), A
                LD      (REDOPTR), A
                LD      (REDOPTR + 1), A
                LD      (UNDOTYP), A
                LD      HL, UNDOBAS
                LD      (UNDOBOT), HL
                LD      (UNDONXT), HL
                RET


; --- UNDOCLS                   ----------------------------------------


; - UNDOCLS ----------------------------
; - CLOSE ACTIVE TYPING COALESCING BURST
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF
; -

UNDOCLS         XOR     A
                LD      (UNDOTYP), A
                RET


; --- SAVE POINT                ----------------------------------------


; - UNDOSAV ----------------------------
; - THE DOCUMENT NOW MATCHES THE FILE (LOADED, SAVED, NEW): REMEMBER THE
; - HISTORY HEAD THAT GOES WITH IT, SO AN UNDO OR REDO THAT LANDS BACK ON
; - IT CLEARS MODIFIED (UNDOPNT). THE TYPING BURST IS CLOSED, OR THE NEXT
; - KEY WOULD JOIN THE HEAD RECORD AND THE HEAD WOULD STILL MATCH.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: AF, HL
; -

UNDOSAV         LD      HL, (UNDOPTR)
                LD      (SAVEPTR), HL
                JP      UNDOCLS


; - UNDOSVC ----------------------------
; - THE REDO CHAIN IS ABOUT TO BE THROWN AWAY: IF THE SAVED STATE IS ONE
; - OF ITS RECORDS IT CAN NO LONGER BE REACHED, AND ITS SLOT WILL BE
; - REUSED -- A HEAD AT THAT ADDRESS WOULD THEN CLAIM A CLEAN DOCUMENT.
; - IN:  NONE (WALKS REDOPTR -> NEXT_TRN)
; - OUT: NONE
; - CLOBBERS: AF, DE, HL
; -

UNDOSVC         LD      HL, (REDOPTR)
                LD      DE, (SAVEPTR)
.WALK           LD      A, H
                OR      L
                RET     Z               ; END OF THE CHAIN: NOT IN IT
                OR      A
                SBC     HL, DE
                ADD     HL, DE          ; KEEPS Z
                JR      Z, UNDOSVX
                INC     HL
                INC     HL
                LD      A, (HL)
                INC     HL
                LD      H, (HL)
                LD      L, A            ; HL = NEXT_TRN
                JR      .WALK


; - UNDOSVE ----------------------------
; - A RECORD IS BEING EVICTED: THE SAVED STATE GOES WITH IT IF IT WAS
; - THAT RECORD, OR IF IT WAS THE EMPTY HISTORY (UNDOING EVERYTHING NO
; - LONGER LEADS BACK TO THE ORIGINAL DOCUMENT)
; - IN:  IX = RECORD BEING EVICTED
; - OUT: NONE
; - CLOBBERS: AF, DE (PRESERVES BC, HL, IX)
; -

UNDOSVE         LD      DE, (SAVEPTR)
                LD      A, D
                OR      E
                JR      Z, UNDOSVX
                PUSH    HL
                PUSH    IX
                POP     HL
                OR      A
                SBC     HL, DE
                POP     HL
                RET     NZ
                ; FALL THROUGH


; - UNDOSVX ----------------------------
; - FORGET THE SAVED STATE: NO UNDO OR REDO CAN CLEAR MODIFIED ANY MORE
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: DE
; -

UNDOSVX         LD      DE, SAVENIL
                LD      (SAVEPTR), DE
                RET


; --- UNDOREC                   ----------------------------------------


; - UNDOREC ----------------------------
; - ALLOCATE RECORD IN RING BUFFER AND WRITE TRANSACTION HEADER & PAYLOAD
; - IN:  A = OP_TYPE (UNDOT_*), OR-ED WITH UNDOF_CHN WHEN THE RECORD BELONGS
; -      TO THE SAME USER ACTION AS THE ONE BEFORE IT
; -      WORKBUF HAS PRE-MUTATION RECORD (NOT READ FOR A SPLIT OR A JOIN)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -
; - THE RECORD IS SIZED BY WHAT IT KEEPS: THE HEADER ALONE FOR A SPLIT OR A
; - JOIN, UNDOMOD_SZ FOR A LINE UP TO TEXTCOLS, UNDOBIG_SZ (UNDOF_BIG) FOR A
; - LONGER ONE -- SO EVERY EDIT IS RECORDED, WHATEVER THE LENGTH OF ITS LINE.
; - THE RING STORES LINE NUMBERS, SO AN EDIT IS RECORDED WHOLE OR THE HISTORY
; - IS DROPPED. A GROUP THAT WOULD NO LONGER FIT THE RING WHOLE (SEE UNDOSIZ
; - IN CONST_CORE) CALLS UNDOINIT AND THE REST OF ITS RECORDS ARE IGNORED
; - (UNDODRP): CHAINED TO NOTHING THEY WOULD REPLAY HALF AN EDIT. SKIPPING
; - ONE RECORD AND KEEPING THE HISTORY IS NEVER AN OPTION -- THE NEXT CTRL+Z
; - REPLAYED OLDER RECORDS OVER LINES THE SKIPPED EDIT HAD CHANGED OR MOVED,
; - AND A HEAD STILL EQUAL TO SAVEPTR CLEARED MODIFIED OVER A DOCUMENT THAT
; - NO LONGER MATCHED THE FILE.
; -

UNDOREC         LD      C, A            ; C = OP_TYPE
                LD      A, (UNDOHLD)
                OR      A
                RET     NZ              ; SUPPRESSED (DURING REDO)

                BIT     7, C            ; UNDOF_CHN
                JR      NZ, .INGRP
                XOR     A               ; A NEW USER ACTION: A NEW GROUP
                LD      (UNDODRP), A
                LD      H, A
                LD      L, A
                LD      (UNDOGSZ), HL
                LD      (UNDOGMX), HL
.INGRP          LD      A, (UNDODRP)
                OR      A
                RET     NZ              ; THE GROUP WAS DROPPED: NONE OF IT

                ; SIZE THE RECORD
                LD      HL, UNDOHDR_SZ
                LD      A, C
                AND     UNDOT_MSK
                CP      UNDOT_SPL
                JR      NC, .SIZED      ; SPLIT, JOIN: NO LINE IMAGE
                LD      HL, UNDOMOD_SZ
                LD      A, (WORKBUF)
                CP      TEXTCOLS + 1
                JR      C, .SIZED
                SET     6, C            ; UNDOF_BIG: LONGER THAN TEXTCOLS
                LD      HL, UNDOBIG_SZ
.SIZED          LD      (UNDORSZ), HL

                ; DOES THE GROUP STILL FIT THE RING WHOLE? DROP IT WHEN
                ; GROUP + THIS RECORD + LARGEST RECORD - 1 > UNDOSIZ
                EX      DE, HL          ; DE = THIS RECORD'S SIZE
                LD      HL, (UNDOGMX)
                CALL    CMPHLDE         ; CY = 1 WHEN THIS ONE IS LARGER
                JR      NC, .MAXOK
                LD      H, D
                LD      L, E
.MAXOK          LD      (UNDOGMX), HL
                PUSH    BC
                LD      BC, (UNDOGSZ)
                ADD     HL, BC
                ADD     HL, DE
                LD      BC, -(UNDOSIZ + 2)
                ADD     HL, BC          ; CY = 1 WHEN THE SUM PASSES UNDOSIZ + 1
                POP     BC
                JR      NC, .KEEP
                LD      A, 1
                LD      (UNDODRP), A
                JP      UNDOINIT        ; TOO BIG TO KEEP: FORGET THE HISTORY
.KEEP           LD      HL, (UNDOGSZ)
                ADD     HL, DE
                LD      (UNDOGSZ), HL

                PUSH    BC
                CALL    UNDOSVC         ; THE REDO CHAIN GOES: SO MAY THE SAVE
                POP     BC

                ; 0. A NEW EDIT ENDS THE REDO CHAIN HERE: CUT THE HEAD'S LINK
                ;    NOW, BEFORE EVICTION WALKS IT. LEFT IN PLACE, EVICTING THE
                ;    HEAD FOLLOWED NEXT_TRN INTO THE STALE REDO RECORDS, KEPT
                ;    UNDOPTR ON THE SLOT BEING OVERWRITTEN, AND THE NEW RECORD
                ;    CAME OUT LINKED TO ITSELF -- CTRL+Z THEN TOGGLED IT FOREVER.
                LD      HL, (UNDOPTR)
                LD      A, H
                OR      L
                JR      Z, .NOREDO
                INC     HL
                INC     HL              ; HL = NEXT_TRN OF THE HEAD
                XOR     A
                LD      (HL), A
                INC     HL
                LD      (HL), A
.NOREDO

                ; 1. COMPUTE ALLOCATION ADDRESS IN RING BUFFER
                LD      HL, (UNDONXT)
                LD      A, H
                OR      L
                JR      NZ, .HAVENX
                LD      HL, UNDOBAS
                LD      (UNDONXT), HL
                LD      (UNDOBOT), HL

.HAVENX         ; DOES IT FIT BEFORE END OF RING BUFFER?
                ; RANGE: [UNDOBAS, UNDOBAS + UNDOSIZ)
                PUSH    HL              ; SAVE CANDIDATE
                LD      DE, (UNDORSZ)
                ADD     HL, DE          ; HL = END OF CANDIDATE RECORD
                LD      DE, UNDOBAS + UNDOSIZ
                OR      A
                SBC     HL, DE          ; CY=1 OR Z=1 IF FITS BEFORE END
                POP     HL              ; RESTORE CANDIDATE
                JR      C, .FITS
                JR      Z, .FITS

                ; DOES NOT FIT AT END: WRAP TO START OF BUFFER. THE TOP, FROM
                ; HERE TO THE END, IS LEFT UNUSED -- BUT WITH RECORDS OF THREE
                ; SIZES AN OLDER, SMALLER ONE CAN STILL LIVE IN IT, AND LEFT
                ; THERE IT STAYS UNDOBOT WHILE THE RECORDS AFTER IT ARE WRITTEN
                ; OVER AT THE BOTTOM: THE CHAIN THEN RUNS THROUGH DEAD RECORDS.
                ; WHAT STARTS IN THE GAP IS EVICTED FIRST.
                LD      A, (UNDOPTR)
                LD      E, A
                LD      A, (UNDOPTR + 1)
                OR      E
                JR      Z, .WRAP        ; BUFFER EMPTY: NOTHING TO EVICT
                PUSH    BC              ; PRESERVE C (OP_TYPE)
                LD      DE, (UNDORSZ)
                PUSH    DE
                EX      DE, HL          ; DE = CANDIDATE
                LD      HL, UNDOBAS + UNDOSIZ
                OR      A
                SBC     HL, DE          ; HL = SIZE OF THE GAP
                LD      (UNDORSZ), HL
                EX      DE, HL          ; HL = CANDIDATE
                CALL    UNDOEVC
                POP     DE
                LD      (UNDORSZ), DE
                POP     BC
.WRAP           LD      HL, UNDOBAS

.FITS           ; HL = WRITE ADDRESS FOR NEW RECORD
                ; 2. EVICT OLDEST TRANSACTIONS IF OVERLAPPING [HL, HL + UNDORSZ)
                LD      A, (UNDOPTR)
                LD      E, A
                LD      A, (UNDOPTR + 1)
                OR      E
                JR      Z, .NOEVCT      ; BUFFER EMPTY: NO EVICTION NEEDED

                PUSH    BC              ; PRESERVE C (OP_TYPE)
                PUSH    HL
                CALL    UNDOEVC
                POP     HL
                POP     BC

.NOEVCT         ; 3. WRITE TRANSACTION HEADER AT HL
                PUSH    HL              ; SAVE RECORD BASE

                ; PREV_TRN = (UNDOPTR)
                LD      DE, (UNDOPTR)
                LD      (HL), E
                INC     HL
                LD      (HL), D
                INC     HL

                ; NEXT_TRN = 0
                LD      (HL), 0
                INC     HL
                LD      (HL), 0
                INC     HL

                ; OP_TYPE
                LD      (HL), C
                INC     HL

                ; DOCLINE
                LD      DE, (DOCLINE)
                LD      (HL), E
                INC     HL
                LD      (HL), D
                INC     HL

                ; CURX
                LD      A, (CURX)
                LD      (HL), A
                INC     HL

                ; TOPLINE
                LD      DE, (TOPLINE)
                LD      (HL), E
                INC     HL
                LD      (HL), D
                INC     HL              ; HL = HL + 10 (PAYLOAD BASE)

                ; 4. PACK WORKBUF INTO THE PAYLOAD, IF THE RECORD KEEPS ONE
                EX      DE, HL          ; DE = DESTINATION (HL + 10)
                LD      A, C
                AND     UNDOT_MSK
                CP      UNDOT_SPL
                JR      NC, .NOPAY      ; SPLIT, JOIN: THE HEADER IS THE RECORD
                LD      A, TEXTCOLS
                BIT     6, C            ; UNDOF_BIG
                JR      Z, .PAKCAP
                LD      A, MAXCOLS
.PAKCAP         LD      HL, WORKBUF     ; HL = SOURCE
                CALL    UNDOPAK         ; DE ADVANCES BY THE PAYLOAD

.NOPAY          POP     HL              ; HL = START OF THIS RECORD

                ; 5. LINK PREVIOUS RECORD'S NEXT_TRN TO THIS RECORD
                LD      BC, (UNDOPTR)
                LD      A, B
                OR      C
                JR      Z, .FIRST
                ; PREVIOUS RECORD EXISTS AT BC. ITS NEXT_TRN IS AT BC + 2
                INC     BC
                INC     BC
                LD      A, L
                LD      (BC), A
                INC     BC
                LD      A, H
                LD      (BC), A
                JR      .LNKDON

.FIRST          ; THIS IS THE FIRST/ONLY RECORD IN EMPTY BUFFER
                LD      (UNDOBOT), HL

.LNKDON         ; 6. UPDATE GLOBAL UNDO STATE
                LD      (UNDOPTR), HL   ; NEW HEAD OF UNDO CHAIN
                EX      DE, HL          ; HL = DE (END OF RECORD: BASE + UNDORSZ)
                LD      (UNDONXT), HL   ; NEXT WRITE LOCATION
                XOR     A
                LD      (REDOPTR), A    ; NEW EDIT INVALIDATES REDO
                LD      (REDOPTR + 1), A
                RET


; --- UNDOBGN                   ----------------------------------------


; - UNDOBGN ----------------------------
; - START OR CONTINUE UNDO TRANSACTION FOR CURRENT LINE
; - IN:  WORKBUF HAS PRE-MUTATION RECORD
; - OUT: NONE
; - CLOBBERS: AF, HL (PRESERVES BC, DE, WORKBUF)
; -

UNDOBGN         PUSH    BC
                PUSH    DE

                ; 1. CHECK IF ALREADY COALESCING ON SAME LINE
                LD      A, (UNDOTYP)
                OR      A
                JR      Z, .NEWTRN      ; NOT COALESCING -> OPEN NEW

                ; ARE WE STILL ON THE SAME DOCLINE?
                LD      HL, (DOCLINE)
                LD      DE, (UNDOLIN)
                OR      A
                SBC     HL, DE
                JP      Z, .DONE        ; SAME LINE -> KEEP COALESCING!

                ; DIFFERENT LINE: CLOSE PREVIOUS
                CALL    UNDOCLS

.NEWTRN         LD      A, UNDOT_MOD
                CALL    UNDOREC

                ; SET COALESCING ACTIVE FOR THIS LINE
                LD      A, 1
                LD      (UNDOTYP), A
                LD      HL, (DOCLINE)
                LD      (UNDOLIN), HL

.DONE           POP     DE
                POP     BC
                RET


; --- UNDODEL                   ----------------------------------------


; - UNDODEL ----------------------------
; - RECORD DELETED LINE IN UNDO RING BUFFER
; - IN:  WORKBUF HAS PRE-MUTATION LINE RECORD
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDODEL         CALL    UNDOCLS
                LD      A, UNDOT_DEL
                JP      UNDOREC


; --- UNDOSPL                   ----------------------------------------


; - UNDOSPL ----------------------------
; - RECORD LINE SPLIT (ENTER) IN UNDO RING BUFFER
; - IN:  WORKBUF HAS PRE-SPLIT LINE RECORD
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOSPL         LD      A, (UNDOHLD)
                OR      A
                RET     NZ
                CALL    UNDOCLS
                LD      A, UNDOT_SPL
                JP      UNDOREC


; --- UNDOJON                   ----------------------------------------


; - UNDOJON ----------------------------
; - RECORD LINE JOIN IN UNDO RING BUFFER: THE HEADER ALONE, AT LINE A AND
; - THE SEAM -- THE UNDO SPLITS LINE A THERE AGAIN, SO NO IMAGE IS KEPT
; - IN:  JOINLA HAS LINE A NUMBER
; -      JOINCOL HAS SEAM COLUMN
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOJON         LD      A, (UNDOHLD)
                OR      A
                RET     NZ
                CALL    UNDOCLS
                LD      HL, (DOCLINE)
                PUSH    HL
                LD      A, (CURX)
                PUSH    AF
                LD      HL, (JOINLA)
                LD      (DOCLINE), HL
                LD      A, (JOINCOL)
                LD      (CURX), A
                LD      A, UNDOT_JON
                CALL    UNDOREC
                POP     AF
                LD      (CURX), A
                POP     HL
                LD      (DOCLINE), HL
                RET


; --- UNDOEVC                   ----------------------------------------


; - UNDOEVC ----------------------------
; - EVICT TRANSACTIONS AT (UNDOBOT) THAT COLLIDE WITH [HL, HL + UNDORSZ),
; - AND WITH EACH ONE THE REST OF ITS GROUP
; - IN:  HL = WRITE BASE ADDRESS
; - OUT: NONE
; - CLOBBERS: AF, DE, IX (PRESERVES BC, HL)
; -

UNDOEVC         ; EVICT TRANSACTIONS AT (UNDOBOT) THAT COLLIDE WITH [HL, HL + UNDORSZ)
.EVCLP          LD      DE, (UNDOBOT)
                LD      A, D
                OR      E
                RET     Z               ; NO MORE RECORDS: DONE

                ; COLLISION WHEN 0 <= UNDOBOT - WRITE BASE < UNDORSZ. ONE
                ; SUBTRACTION FOR BOTH BOUNDS: THE OLD SECOND TEST RE-DID IT
                ; AFTER EX DE, HL HAD LEFT THE WRITE BASE IN BOTH REGISTERS,
                ; GOT 0 EVERY TIME, AND SO EVICTED EVERY RECORD ABOVE THE
                ; WRITE POINT -- THE WHOLE HISTORY ON EACH WRAP OF THE RING.
                PUSH    HL
                EX      DE, HL          ; HL = UNDOBOT, DE = WRITE BASE
                OR      A
                SBC     HL, DE          ; HL = UNDOBOT - WRITE BASE
                JR      C, .EVCBEL      ; BELOW THE WINDOW
                LD      DE, (UNDORSZ)
                SBC     HL, DE          ; CY = 1 INSIDE THE WINDOW (CY WAS 0)
                POP     HL              ; HL = WRITE BASE
                JR      NC, .EVCDON     ; PAST THE WINDOW -> DONE

                ; COLLISION DETECTED: EVICT RECORD AT (UNDOBOT)
.EVICT          LD      IX, (UNDOBOT)
                CALL    UNDOSVE         ; THE SAVED STATE MAY GO WITH IT
                LD      E, (IX + 2)     ; NEXT_TRN LOW
                LD      D, (IX + 3)     ; NEXT_TRN HIGH
                LD      A, D
                OR      E
                JR      NZ, .EVCNXT

                ; WAS THE ONLY RECORD: BUFFER NOW EMPTY
                XOR     A
                LD      (UNDOPTR), A
                LD      (UNDOPTR + 1), A
                LD      (UNDOBOT), A
                LD      (UNDOBOT + 1), A
                RET

.EVCNXT         ; ADVANCE UNDOBOT = NEXT_TRN AND CLEAR ITS PREV_TRN
                LD      (UNDOBOT), DE
                PUSH    HL
                EX      DE, HL          ; HL = NEW BOT RECORD
                LD      (HL), 0         ; PREV_TRN = 0
                INC     HL
                LD      (HL), 0
                POP     HL
                ; A GROUP GOES WHOLE: IF THE NEW BOTTOM IS CHAINED TO THE RECORD
                ; JUST EVICTED IT IS THE REST OF THAT USER ACTION, AND UNDOING
                ; IT WITHOUT ITS FIRST RECORD WOULD REPLAY HALF AN EDIT
                LD      IX, (UNDOBOT)
                LD      A, (IX + 4)
                AND     UNDOF_CHN
                JR      NZ, .EVICT
                JR      .EVCLP          ; CHECK IF NEXT RECORD ALSO COLLIDES

.EVCBEL         POP     HL              ; HL = WRITE BASE
.EVCDON         RET


; --- UNDOSWP                   ----------------------------------------


; - UNDOSWP ----------------------------
; - SWAP DOCUMENT LINE RECORD WITH UNDO PAYLOAD AND RESTORE CURSOR
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED (NO MEMORY FOR THE LONGER LINE:
; -      NOTHING CHANGED, THE RECORD INCLUDED). NOTHING IS PAINTED: THE
; -      CALLER REPAINTS ONCE, THROUGH UNDOPNT
; - CLOBBERS: ALL
; -

UNDOSWP         ; 1. SET TARGET DOCLINE
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL

                ; 2. READ CURRENT DOCUMENT LINE INTO WORKBUF
                CALL    LINEREAD        ; READS (DOCLINE) INTO WORKBUF (HL IS DOCLINE)

                ; 3. COPY CURRENT DOCUMENT LINE (WORKBUF) TO WORKBUF2
                LD      HL, WORKBUF
                LD      DE, WORKBUF2
                LD      BC, WORKSIZ
                LDIR                    ; WORKBUF2 NOW HOLDS CURRENT LINE

                ; 4. UNPACK UNDO PAYLOAD (IX + 10) INTO WORKBUF
                PUSH    IX
                POP     HL
                LD      DE, UNDOHDR_SZ
                ADD     HL, DE          ; HL = IX + 10 (PAYLOAD)
                LD      DE, WORKBUF
                CALL    UNDOCAP
                CALL    UNDOUPK         ; WORKBUF NOW HOLDS RESTORED LINE

                ; 5. WRITE RESTORED LINE TO DOCUMENT
                LD      HL, (DOCLINE)
                CALL    LINEWRT
                RET     C               ; NO MEMORY: THE PAYLOAD IS UNTOUCHED

                ; 6. PACK DISPLACED LINE (WORKBUF2) BACK INTO UNDO PAYLOAD (IX + 10).
                ;    A NORMAL RECORD HOLDS TEXTCOLS CHARACTERS, AND THE EDIT MAY
                ;    HAVE MADE ITS LINE LONGER: THEN THE UNDO IS EXACT AND ONLY
                ;    ITS REDO IS LOST (ACTUNDO DROPS IT AT THE END).
                CALL    UNDOCAP
                LD      B, A
                LD      A, (WORKBUF2)
                CP      B
                JR      C, .PACK
                JR      Z, .PACK
                LD      (UNDONRD), A    ; NON-ZERO: NO REDO FOR THIS ACTION
.PACK           PUSH    IX
                POP     DE
                LD      HL, UNDOHDR_SZ
                ADD     HL, DE
                EX      DE, HL          ; DE = IX + 10
                LD      HL, WORKBUF2
                CALL    UNDOCAP
                CALL    UNDOPAK         ; PAYLOAD SWAPPED FOR REDO!

                ; 6. SWAP CURX IN RECORD (IX + 7) WITH CURRENT CURX
                LD      A, (CURX)
                LD      B, (IX + 7)
                LD      (IX + 7), A     ; RECORD GETS DISPLACED CURX
                LD      A, B
                LD      (CURX), A       ; CURX RESTORED!

                ; 7. RESTORE TOPLINE
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL

                ; 8. MARK MODIFIED; ACTUNDO / ACTREDO PAINT ONCE PER GROUP
                JP      UNDOOK


; --- ACTUNDO                   ----------------------------------------


; - ACTUNDO ----------------------------
; - UNDO LAST USER ACTION (CTRL+Z / VI U): EVERY RECORD OF ITS GROUP, NEWEST
; - FIRST, THEN ONE REPAINT
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTUNDO         CALL    UNDOCLS
                LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDSEL
                LD      HL, (UNDOPTR)
                LD      A, H
                OR      L
                RET     Z               ; NOTHING TO UNDO
                XOR     A
                LD      (UNDONRD), A

.UNLOOP         PUSH    HL
                POP     IX
                LD      A, (IX + 4)
                PUSH    AF              ; THE RECORD'S CHAIN FLAG
                CALL    UNDODSP
                POP     BC              ; B = OP BYTE; POP KEEPS THE CARRY
                JR      C, .FINISH      ; REFUSED: STOP, PAINT WHAT WAS DONE
                LD      A, B
                AND     UNDOF_CHN
                JR      Z, .FINISH      ; THE GROUP'S FIRST RECORD: DONE
                LD      HL, (UNDOPTR)
                LD      A, H
                OR      L
                JR      NZ, .UNLOOP

.FINISH         LD      A, (UNDONRD)    ; A LINE TOO LONG TO KEEP CAME OUT:
                OR      A               ; THIS ACTION CANNOT BE REDONE
                JP      Z, UNDOPNT
                CALL    UNDOSVC         ; THE REDO CHAIN GOES: SO MAY THE SAVE
                LD      HL, 0
                LD      (REDOPTR), HL
                JP      UNDOPNT


; - UNDODSP ----------------------------
; - REVERSE ONE RECORD
; - IN:  IX = RECORD AT UNDOPTR
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED
; - CLOBBERS: ALL
; -

UNDODSP         LD      A, (IX + 4)
                AND     UNDOT_MSK
                CP      UNDOT_MOD
                JR      Z, .DOMOD
                CP      UNDOT_DEL
                JP      Z, UNDORST      ; RE-INSERT THE LINE
                CP      UNDOT_SPL
                JP      Z, UNDOSPU      ; MERGE THE HALVES BACK
                CP      UNDOT_JON
                JP      Z, UNDOJNU      ; SEPARATE THE LINES AGAIN
                SCF
                RET

.DOMOD          ; SWAP DOCUMENT WITH PAYLOAD (RESTORING PRE-MUTATION STATE)
                CALL    UNDOSWP
                RET     C
                JP      UNDOBCK         ; THE RECORD NOW HEADS THE REDO CHAIN


; --- ACTREDO                   ----------------------------------------


; - ACTREDO ----------------------------
; - REDO LAST UNDONE USER ACTION (CTRL+SHIFT+Z / VI CTRL+R): EVERY RECORD
; - OF ITS GROUP, OLDEST FIRST, THEN ONE REPAINT. THE CURSOR ENDS WHERE THE
; - GROUP'S FIRST RECORD PUT IT, AS IT DOES AFTER AN UNDO.
; - IN:  NONE
; - OUT: NONE
; - CLOBBERS: ALL
; -

ACTREDO         CALL    UNDOCLS
                LD      A, (SELACT)
                OR      A
                CALL    NZ, ACTDSEL
                LD      HL, (REDOPTR)
                LD      A, H
                OR      L
                RET     Z               ; NOTHING TO REDO

                PUSH    HL
                POP     IX
                CALL    REDODSP
                JP      C, UNDOPNT      ; REFUSED: NOTHING CHANGED

                ; KEEP THE CURSOR THE FIRST RECORD LEFT
                LD      HL, (TOPLINE)
                PUSH    HL
                LD      HL, (DOCLINE)
                PUSH    HL
                LD      A, (CURX)
                PUSH    AF

.RDLOOP         LD      HL, (REDOPTR)
                LD      A, H
                OR      L
                JR      Z, .RDDONE
                PUSH    HL
                POP     IX
                LD      A, (IX + 4)
                AND     UNDOF_CHN
                JR      Z, .RDDONE      ; NEXT RECORD STARTS ANOTHER ACTION
                CALL    REDODSP
                JR      NC, .RDLOOP

.RDDONE         POP     AF
                LD      (CURX), A
                POP     HL
                LD      (DOCLINE), HL
                POP     HL
                LD      (TOPLINE), HL
                JP      UNDOPNT


; - REDODSP ----------------------------
; - RE-APPLY ONE RECORD
; - IN:  IX = RECORD AT REDOPTR
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED
; - CLOBBERS: ALL
; -

REDODSP         LD      A, (IX + 4)
                AND     UNDOT_MSK
                CP      UNDOT_MOD
                JR      Z, .DOMOD
                CP      UNDOT_DEL
                JP      Z, UNDOKIL      ; DELETE THE LINE AGAIN
                CP      UNDOT_SPL
                JP      Z, REDOSPL      ; SPLIT THE LINE AGAIN
                CP      UNDOT_JON
                JP      Z, REDOJON      ; JOIN THE LINES AGAIN
                SCF
                RET

.DOMOD          ; SWAP DOCUMENT WITH PAYLOAD (RESTORES MUTATION STATE)
                CALL    UNDOSWP
                RET     C
                JP      UNDOFWD         ; THE RECORD NOW HEADS THE UNDO CHAIN


; --- UNDOPNT                   ----------------------------------------


; - UNDOPNT ----------------------------
; - REPAINT AFTER AN UNDO OR REDO: ONCE PER GROUP, NOT ONCE PER RECORD --
; - A 46-LINE GROUP WOULD OTHERWISE COST 46 FULL REDRAWS. SHOWLN BRINGS THE
; - CURSOR LINE INTO THE VIEWPORT: A RESTORED TOPLINE NEED NOT SHOW IT WHEN
; - THE ACTION BEGAN ABOVE THE SCREEN (A SELECTION STARTED OFF IT).
; - THE STATUS BAR AND THE CURSOR ARE LEFT TO MAINLOOP'S .DRAWCUR, LIKE
; - EVERY OTHER ACTION: THE CURSOR IS AN XOR, AND DRAWING IT HERE AS WELL
; - CANCELLED IT OUT WHILE BLNKPH SAID IT WAS UP, SO THE NEXT KEY'S ERASE
; - PAINTED IT INSTEAD AND EVERY UNDO LEFT AN INVERTED CELL BEHIND.
; - MODIFIED IS DECIDED HERE, ONCE FOR THE GROUP: CLEAR WHEN THE HISTORY
; - HEAD IS THE ONE THE FILE WAS LOADED OR SAVED AT (SAVEPTR), SET
; - OTHERWISE -- UNDOING BACK TO THE FILE LEFT THE ASTERISK ON.
; - IN:  DOCLINE, CURX, TOPLINE
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOPNT         LD      HL, (UNDOPTR)
                LD      DE, (SAVEPTR)
                OR      A
                SBC     HL, DE
                LD      A, #FF
                JR      NZ, .MODSET
                XOR     A
.MODSET         LD      (MODIFIED), A
                LD      HL, (DOCLINE)
                CALL    SHOWLN
                XOR     A
                LD      (LEFTCOL), A
                CALL    ADJLCOL
                JP      REDRAW


; - UNDOOK -----------------------------
; - COMMON EXIT OF A PRIMITIVE THAT APPLIED ITS RECORD
; - IN:  NONE
; - OUT: CY = 0
; - CLOBBERS: AF
; -

UNDOOK          LD      A, #FF
                LD      (MODIFIED), A
                OR      A               ; CY = 0
                RET


; --- UNDOLNR                   ----------------------------------------


; - UNDOLNR ----------------------------
; - RECORD WORKBUF AS THE PRE-MUTATION IMAGE OF ANY DOCUMENT LINE, NOT
; - ONLY DOCLINE. THE HEADER TAKES ITS LINE FROM DOCLINE, SO IT IS LENT
; - FOR THE CALL AND PUT BACK.
; - IN:  A = OP (UNDOT_* [| UNDOF_CHN]), HL = LINE, WORKBUF = ITS RECORD
; - OUT: NONE
; - CLOBBERS: ALL
; -

UNDOLNR         LD      DE, (DOCLINE)
                PUSH    DE
                LD      (DOCLINE), HL
                CALL    UNDOREC
                POP     HL
                LD      (DOCLINE), HL
                RET


; --- UNDOSEL                   ----------------------------------------


; - UNDOSEL ----------------------------
; - RECORD THE LINES OF THE SELECTION, BEFORE THEY CHANGE, AS ONE GROUP:
; - SELSTRL AS UNDOT_MOD (THE GROUP'S FIRST RECORD), THEN EVERY FOLLOWING
; - LINE UP TO SELENDL CHAINED. EVERY RECORD CARRIES CURX = SELSTRX, THE
; - CURSOR BOTH UNDO AND REDO LEAVE.
; - A GROUP TOO BIG FOR THE RING IS NOT RECORDED HALF: UNDOREC DROPS THE
; - HISTORY INSTEAD, SINCE EVERY RECORD IN IT WOULD NAME LINES THIS EDIT
; - IS ABOUT TO MOVE.
; - IN:  A = OP FOR THE FOLLOWING LINES:
; -          UNDOT_DEL  THEY ARE ABOUT TO BE DELETED; EACH IS RECORDED AT
; -                     SELSTRL + 1, WHERE EVERY ONE OF THEM IS DELETED
; -          UNDOT_MOD  THEY ARE ABOUT TO CHANGE IN PLACE; EACH AT ITS LINE
; -      SELSTRL, SELSTRX, SELENDL (NORMALIZED)
; - OUT: CURX AND DOCLINE UNCHANGED, WORKBUF CLOBBERED
; - CLOBBERS: ALL
; -

UNDOSEL         PUSH    AF              ; OP FOR THE FOLLOWING LINES
                CALL    UNDOCLS
                LD      A, (CURX)
                PUSH    AF              ; CURX, PUT BACK ON EXIT

                LD      A, (SELSTRX)
                LD      (CURX), A
                LD      HL, (SELSTRL)
                CALL    LINEREAD
                LD      HL, (SELSTRL)
                LD      A, UNDOT_MOD
                CALL    UNDOLNR         ; THE GROUP'S FIRST RECORD

                LD      HL, (SELSTRL)
.LNLOOP         LD      DE, (SELENDL)
                CALL    CMPHLDE
                JR      NC, .DONE       ; EVERY LINE UP TO SELENDL RECORDED
                INC     HL
                PUSH    HL
                CALL    LINEREAD
                POP     HL
                POP     BC              ; B = SAVED CURX
                POP     AF              ; A = OP
                PUSH    AF
                PUSH    BC
                PUSH    HL
                CP      UNDOT_DEL
                JR      NZ, .OWNLN
                LD      HL, (SELSTRL)
                INC     HL              ; DELETED LINES ALL GO AT SELSTRL + 1
.OWNLN          OR      UNDOF_CHN
                CALL    UNDOLNR
                POP     HL
                JR      .LNLOOP

.DONE           POP     AF
                LD      (CURX), A
                POP     AF
                RET


; --- UNDORST                   ----------------------------------------


; - UNDORST ----------------------------
; - REVERSE LINE DELETION: RE-INSERT LINE INTO DOCUMENT
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED (NOTHING CHANGED). NOTHING IS
; -      PAINTED: THE CALLER REPAINTS ONCE, THROUGH UNDOPNT
; - CLOBBERS: ALL
; -

UNDORST         ; 1. CHECK IF LINE DIRECTORY IS FULL
                LD      HL, (TOTLINES)
                LD      DE, MAXLINES
                CALL    CMPHLDE
                CCF
                RET     C               ; DIRECTORY FULL: REFUSE RESURRECTION

                ; 2. RESERVE SPACE IN MAPPER FOR RESTORED LINE
                LD      C, (IX + UNDOHDR_SZ)
                CALL    NEWREC
                RET     C               ; OOM: CANNOT UNDO DELETION

                ; SAVE RETURNED SEGMENT AND OFFSET
                LD      (NRSEG), A
                LD      (NROFF), DE

                ; 3. UPDATE UNDOPTR AND REDOPTR
                CALL    UNDOBCK

                ; 4. WRITE PAYLOAD (IX + 10) INTO (NRSEG, NROFF)
                PUSH    IX
                POP     HL
                LD      BC, UNDOHDR_SZ
                ADD     HL, BC          ; HL = SOURCE (IX + 10)
                LD      DE, WORKBUF
                CALL    UNDOCAP
                CALL    UNDOUPK
                LD      HL, WORKBUF
                LD      A, (NRSEG)
                LD      DE, (NROFF)
                CALL    PUTREC

                ; 5. OPEN DIRECTORY SLOT AT (IX + 5) AND FILL IT
                LD      L, (IX + 5)
                LD      H, (IX + 6)     ; HL = DOCLINE
                PUSH    HL
                CALL    LINEINS
                POP     HL
                LD      DE, (NROFF)
                LD      A, (NRSEG)
                CALL    DIRWRITE

                ; 6. BUMP TOTLINES
                LD      HL, (TOTLINES)
                INC     HL
                LD      (TOTLINES), HL

                ; 7. RESTORE DOCLINE, CURX, TOPLINE
                CALL    UNDOCUR

                ; 8. MARK MODIFIED; ACTUNDO / ACTREDO PAINT ONCE PER GROUP
                JP      UNDOOK


; --- UNDOKIL                   ----------------------------------------


; - UNDOKIL ----------------------------
; - RE-APPLY LINE DELETION (REDO OF DELETED LINE)
; - IN:  IX = TRANSACTION ADDRESS
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED (NOTHING CHANGED). NOTHING IS
; -      PAINTED: THE CALLER REPAINTS ONCE, THROUGH UNDOPNT
; - CLOBBERS: ALL
; -

UNDOKIL         ; 1. ADVANCE REDOPTR AND UPDATE UNDOPTR
                CALL    UNDOFWD

                ; 2. DELETE LINE AT (IX + 5)
                LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL
                CALL    LINEDEL

                ; 3. DECREMENT TOTLINES
                LD      HL, (TOTLINES)
                DEC     HL
                LD      (TOTLINES), HL

                ; 4. CLAMP DOCLINE IF DOCLINE >= TOTLINES
                LD      HL, (DOCLINE)
                LD      DE, (TOTLINES)
                CALL    CMPHLDE
                JR      C, .DKLOK
                DEC     HL
                LD      (DOCLINE), HL

.DKLOK          ; 5. CURSOR TO COL 0, RESTORE TOPLINE
                XOR     A
                LD      (CURX), A
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL
                JP      UNDOOK


; --- STRUCTURAL PRIMITIVES     ----------------------------------------
;
; A SPLIT AND A JOIN KEEP NO LINE IMAGE: EACH IS UNDONE AND REDONE BY THE
; EDIT THAT IS ITS INVERSE, RUN ON THE LINES AS THEY ARE -- JOIN2L MERGES
; THE TWO HALVES OF A SPLIT, EDNWLIN SPLITS A JOINED LINE AT ITS SEAM.
; RESTORING A STORED IMAGE COULD NOT DO IT: A RECORD HELD TEXTCOLS
; CHARACTERS AND A LINE REACHES MAXCOLS, SO THE TAIL OF A LONG LINE WAS
; LOST. EVERY PRIMITIVE APPLIES ITS EDIT FIRST AND MOVES THE POINTERS
; ONLY ONCE IT HAS SUCCEEDED, SO A REFUSAL LEAVES DOCUMENT AND HISTORY
; AS THEY WERE.


; - UNDOBCK ----------------------------
; - THE RECORD AT IX HAS BEEN UNDONE: IT HEADS THE REDO CHAIN, AND ITS
; - PREDECESSOR THE UNDO CHAIN
; - IN:  IX = RECORD
; - OUT: NONE (FLAGS PRESERVED)
; - CLOBBERS: HL
; -

UNDOBCK         LD      (REDOPTR), IX
                LD      L, (IX + 0)
                LD      H, (IX + 1)
                LD      (UNDOPTR), HL
                RET


; - UNDOFWD ----------------------------
; - THE RECORD AT IX HAS BEEN REDONE: IT HEADS THE UNDO CHAIN, AND ITS
; - SUCCESSOR THE REDO CHAIN
; - IN:  IX = RECORD
; - OUT: NONE (FLAGS PRESERVED)
; - CLOBBERS: HL
; -

UNDOFWD         LD      (UNDOPTR), IX
                LD      L, (IX + 2)
                LD      H, (IX + 3)
                LD      (REDOPTR), HL
                RET


; - UNDOCUR ----------------------------
; - PUT THE CURSOR AND THE VIEWPORT WHERE THE RECORD AT IX SAYS
; - IN:  IX = RECORD
; - OUT: DOCLINE, CURX, TOPLINE
; - CLOBBERS: AF, HL
; -

UNDOCUR         LD      L, (IX + 5)
                LD      H, (IX + 6)
                LD      (DOCLINE), HL
                LD      A, (IX + 7)
                LD      (CURX), A
                LD      L, (IX + 8)
                LD      H, (IX + 9)
                LD      (TOPLINE), HL
                RET


; - UNDOJ2L ----------------------------
; - JOIN LINE (IX + 5) AND THE ONE BELOW IT, WITHOUT RECORDING
; - IN:  IX = RECORD
; - OUT: CY = 1 REFUSED (NOTHING CHANGED); IX PRESERVED
; - CLOBBERS: ALL BUT IX
; -

UNDOJ2L         LD      L, (IX + 5)
                LD      H, (IX + 6)     ; HL = LINE A
                LD      E, L
                LD      D, H
                INC     DE              ; DE = LINE B (LINE A + 1)
                LD      A, 1
                LD      (UNDOHLD), A
                PUSH    IX
                CALL    JOIN2L
                POP     IX
                LD      A, 0            ; KEEPS THE CARRY
                LD      (UNDOHLD), A
                RET


; - UNDONWX ----------------------------
; - SPLIT LINE (IX + 5) AT COLUMN (IX + 7) EXACTLY, WITHOUT RECORDING OR
; - PAINTING: THE UNDO OF A JOIN. WRAP_DEV FOR THE CALL, SINCE IN WRAP_TXT
; - EFFCURX MOVES A SPLIT ON THE MARGIN OF A FULL LINE ONE COLUMN ON.
; - UNDONWL ----------------------------
; - THE SAME, IN THE CURRENT WRAP MODE: THE REDO OF AN ENTER, WHICH
; - RECORDED THE CURSOR AND RE-DERIVES THE COLUMN JUST AS THE KEY DID.
; - IN:  IX = RECORD
; - OUT: CY = 1 REFUSED (NOTHING CHANGED); IX PRESERVED. EDNWLIN REFUSES
; -      IN SILENCE (DIRECTORY FULL, NO RECORD), SO THE LINE COUNT TELLS.
; -      THE CURSOR IS WHERE EDNWLIN LEFT IT: ON THE NEW LINE, COLUMN 0.
; - CLOBBERS: ALL BUT IX
; -

UNDONWX         LD      A, WRAP_DEV
                JR      UNDONW0

UNDONWL         LD      A, (WRAPMODE)
UNDONW0         LD      B, A
                CALL    UNDOCUR
                CALL    SETCURY
                LD      HL, (TOTLINES)
                PUSH    HL
                LD      A, (WRAPMODE)
                PUSH    AF
                LD      A, (RNDHOLD)
                PUSH    AF
                LD      A, B
                LD      (WRAPMODE), A
                LD      A, 1
                LD      (UNDOHLD), A
                LD      (RNDHOLD), A    ; UNDOPNT REPAINTS ONCE, LATER
                PUSH    IX
                CALL    EDNWLIN
                POP     IX
                XOR     A
                LD      (UNDOHLD), A
                POP     AF
                LD      (RNDHOLD), A
                POP     AF
                LD      (WRAPMODE), A
                POP     DE
                LD      HL, (TOTLINES)
                OR      A
                SBC     HL, DE
                SCF
                RET     Z               ; NO NEW LINE: REFUSED
                OR      A
                RET


; - UNDOSPU ----------------------------
; - REVERSE LINE SPLIT (MERGE LINES BACK TOGETHER)
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED (NOTHING CHANGED). NOTHING IS
; -      PAINTED: THE CALLER REPAINTS ONCE, THROUGH UNDOPNT
; - CLOBBERS: ALL
; -

UNDOSPU         CALL    UNDOJ2L
                RET     C
                CALL    UNDOBCK
                CALL    UNDOCUR
                JP      UNDOOK


; - REDOSPL ----------------------------
; - RE-APPLY LINE SPLIT (ENTER)
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED (NOTHING CHANGED). NOTHING IS
; -      PAINTED: THE CALLER REPAINTS ONCE, THROUGH UNDOPNT
; - CLOBBERS: ALL
; -
; - A REFUSED SPLIT MUST NOT ADVANCE THE POINTERS, OR THE NEXT CTRL+Z RUNS
; - UNDOSPU AND MERGES AWAY AN UNRELATED LINE.
; -

REDOSPL         CALL    UNDONWL
                RET     C
                CALL    UNDOFWD
                JP      UNDOOK


; - UNDOJNU ----------------------------
; - REVERSE LINE JOIN: SPLIT LINE A AGAIN AT THE SEAM
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED (NOTHING CHANGED). NOTHING IS
; -      PAINTED: THE CALLER REPAINTS ONCE, THROUGH UNDOPNT
; - CLOBBERS: ALL
; -

UNDOJNU         CALL    UNDONWX
                RET     C
                CALL    UNDOBCK
                CALL    UNDOCUR
                JP      UNDOOK


; - REDOJON ----------------------------
; - RE-APPLY LINE JOIN
; - IN:  IX = UNDO TRANSACTION ADDRESS
; - OUT: CY = 0 APPLIED, CY = 1 REFUSED (NOTHING CHANGED). NOTHING IS
; -      PAINTED: THE CALLER REPAINTS ONCE, THROUGH UNDOPNT
; - CLOBBERS: ALL
; -

REDOJON         CALL    UNDOJ2L
                RET     C
                CALL    UNDOFWD
                CALL    UNDOCUR
                JP      UNDOOK


; --- UNDOPAK                   ----------------------------------------


; - UNDOCAP ----------------------------
; - PAYLOAD CAPACITY OF A RECORD, IN CHARACTERS
; - IN:  IX = RECORD
; - OUT: A = TEXTCOLS, OR MAXCOLS FOR A RECORD FLAGGED UNDOF_BIG
; - CLOBBERS: AF
; -

UNDOCAP         LD      A, (IX + 4)
                AND     UNDOF_BIG
                LD      A, TEXTCOLS
                RET     Z
                LD      A, MAXCOLS
                RET


; - UNDOPAK ----------------------------
; - PACK LINE BUFFER INTO UNDO RECORD PAYLOAD (1 + 2 * CAPACITY BYTES)
; - IN:  HL = SOURCE BUFFER (WORKBUF OR WORKBUF2)
; -      DE = DESTINATION IN UNDO RING BUFFER
; -      A  = CAPACITY (TEXTCOLS OR MAXCOLS)
; - OUT: DE ADVANCED BY 1 + 2 * CAPACITY BYTES
; - CLOBBERS: AF, BC, DE, HL
; -

UNDOPAK         ; 1. COPY LENGTH (1 BYTE)
                LDI                     ; (DE)=(HL), HL++, DE++

                ; 2. COPY TEXT (CAPACITY BYTES)
                LD      C, A
                LD      B, 0
                PUSH    BC              ; SAVE BC = CAPACITY
                PUSH    HL              ; SAVE HL = SOURCE BUFFER + 1
                LDIR

                ; 3. ADVANCE HL TO ATTRIBUTES (SOURCE BUFFER + 1 + WORKATTR)
                POP     HL              ; HL = SOURCE BUFFER + 1
                LD      BC, WORKATTR
                ADD     HL, BC          ; HL = SOURCE BUFFER + 1 + WORKATTR

                ; 4. COPY ATTRIBUTES (CAPACITY BYTES)
                POP     BC
                LDIR
                RET


; --- UNDOUPK                   ----------------------------------------


; - UNDOUPK ----------------------------
; - UNPACK UNDO RECORD PAYLOAD (1 + 2 * CAPACITY BYTES) INTO LINE BUFFER
; - IN:  HL = SOURCE PAYLOAD IN UNDO RING BUFFER
; -      DE = DESTINATION BUFFER (WORKBUF OR WORKBUF2)
; -      A  = CAPACITY (TEXTCOLS OR MAXCOLS)
; - OUT: NONE
; - CLOBBERS: AF, BC, DE, HL
; -

UNDOUPK         ; 1. COPY LENGTH (1 BYTE)
                LDI                     ; (DE)=(HL), HL++, DE++

                ; 2. COPY TEXT (CAPACITY BYTES)
                LD      C, A
                LD      B, 0
                PUSH    BC              ; SAVE BC = CAPACITY
                PUSH    DE              ; SAVE DE = DEST BUFFER + 1
                LDIR                    ; HL = SRC ATTR

                ; 3. ADVANCE DEST TO ATTRIBUTES (DEST BUFFER + 1 + WORKATTR)
                POP     DE              ; DE = DEST BUFFER + 1
                LD      BC, WORKATTR
                EX      DE, HL          ; HL = DEST BUFFER + 1, DE = SRC ATTR
                ADD     HL, BC          ; HL = DEST BUFFER + 1 + WORKATTR
                EX      DE, HL          ; DE = DEST BUFFER + 1 + WORKATTR, HL = SRC ATTR

                ; 4. COPY ATTRIBUTES (CAPACITY BYTES)
                POP     BC
                LDIR
                RET
